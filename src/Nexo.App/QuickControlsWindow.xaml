<Window x:Class="Nexo.App.QuickControlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.Name="Volumen y brillo"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <!--
        Diseño D35 — pulsar a media altura pone ese valor, igual que en el volumen de un teléfono; no
        es un Slider de WPF, que arrastra desde donde se agarra.

        2026-09-14 — las píldoras de relleno dieron paso al mando líquido (LiquidLevelGauge): una regla,
        una línea que se abomba alrededor del pomo y el valor en grande al lado, uno junto al otro.
    -->

    <!--
        Diseño D40 — la ventana es más ancha que el panel a propósito, y este margen es el hueco.

        Antes la ventana medía exactamente lo que el panel, y la sombra proyectada no tenía dónde
        caer: Windows la recortaba contra el borde de la ventana y quedaba un rectángulo gris con un
        canto recto a un lado. Eso era lo que se veía como «fondo gris» y «el lado derecho recto»;
        no era el carril ni el relleno, era la sombra cortada.
    -->
    <Grid x:Name="PanelBorder" Margin="30" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="PanelTranslate" X="0" />
        </Grid.RenderTransform>

        <!-- Diseño D69 — metido hacia dentro para que no asome por las esquinas. -->
        <Border Margin="2"
                CornerRadius="30"
                Background="{DynamicResource BrushSidebarSurface}"
                CacheMode="BitmapCache">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="8" Opacity="0.4" Color="#000000" />
            </Border.Effect>
        </Border>

        <Border Padding="12,14,8,10"
                CornerRadius="30"
                Background="{DynamicResource BrushSidebarSurface}"
                BorderBrush="{DynamicResource BrushAccentBorder}"
                BorderThickness="1">
            <StackPanel x:Name="ControlsPanel" Orientation="Horizontal" />
        </Border>
    </Grid>
</Window>
