<Window x:Class="Nexo.App.QuickControlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.Name="Volumen y brillo"
        Width="144"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <Window.Resources>
        <!--
            Diseño D35 — el mando es una barra vertical con el icono dentro del propio pulgar, como
            en el boceto. No es un Slider de WPF con otro aspecto: un Slider vertical arrastra desde
            donde se agarra, y aquí lo que se quiere es que pulsar a media altura ponga ese valor,
            igual que en el volumen de un teléfono.
        -->
        <!--
            Diseño D39 — sin borde. La línea de un píxel se leía como un delineado gris suelto
            alrededor de cada carril, sobre todo con el relleno claro encima: dos contornos
            compitiendo por describir la misma forma. El carril ya se distingue por su fondo, que es
            más oscuro que el del panel, y esa diferencia basta para ver dónde acaba sin dibujar una
            raya que no aporta nada.
        -->
        <Style x:Key="ControlTrackStyle" TargetType="Border">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="164" />
            <Setter Property="CornerRadius" Value="26" />
            <Setter Property="Background" Value="{DynamicResource BrushInput}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </Window.Resources>

    <!--
        Diseño D40 — la ventana es más ancha que el panel a propósito, y este margen es el hueco.

        Antes la ventana medía exactamente lo que el panel, y la sombra proyectada no tenía dónde
        caer: Windows la recortaba contra el borde de la ventana y quedaba un rectángulo gris con un
        canto recto a un lado. Eso era lo que se veía como «fondo gris» y «el lado derecho recto»;
        no era el carril ni el relleno, era la sombra cortada.
    -->
    <Grid x:Name="PanelBorder" Margin="30" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="PanelTranslate" X="0" />
        </Grid.RenderTransform>

        <!-- Diseño D69 — metido hacia dentro para que no asome por las esquinas. -->
        <Border Margin="2"
                CornerRadius="30"
                Background="{DynamicResource BrushSidebarSurface}"
                CacheMode="BitmapCache">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="8" Opacity="0.4" Color="#000000" />
            </Border.Effect>
        </Border>

        <Border Padding="16"
                CornerRadius="30"
                Background="{DynamicResource BrushSidebarSurface}"
                BorderBrush="{DynamicResource BrushAccentBorder}"
                BorderThickness="1">
            <StackPanel x:Name="ControlsPanel" />
        </Border>
    </Grid>
</Window>
