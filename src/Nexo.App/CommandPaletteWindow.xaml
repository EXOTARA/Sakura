<Window x:Class="Nexo.App.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a11y="clr-namespace:Nexo.App.Views.Controls"
        Title="Comandos de Sakura"
        Width="720"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        SourceInitialized="Window_SourceInitialized"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="PaletteIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="{DynamicResource BrushSurfaceRaised}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource BrushTextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface"
                                        Property="BorderBrush"
                                        Value="{DynamicResource BrushAccent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuggestionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="15">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemSurface"
                                        Property="Background"
                                        Value="{DynamicResource BrushSurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface"
                                        Property="Background"
                                        Value="{DynamicResource BrushAccentSoft}" />
                                <Setter TargetName="ItemSurface"
                                        Property="BorderBrush"
                                        Value="{DynamicResource BrushAccentBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MotionChipStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="BorderBrush" Value="#30FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!--
                            2026-09-14 — con canto y relleno propios. Sobre el panel de movimiento el
                            relleno del tema casi coincidía con el fondo, y las cuatro opciones se leían
                            como texto suelto en vez de como botones.
                        -->
                        <Border x:Name="ChipSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipSurface" Property="Opacity" Value="0.84" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource BrushTextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChipSurface"
                                        Property="BorderBrush"
                                        Value="{DynamicResource BrushAccent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChipSurface" Property="Opacity" Value="0.64" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        Diseño D62 — sin AllowsTransparency: el acrílico, las esquinas y la sombra los pone DWM.
        Los veinticuatro píxeles de margen existían para que cayera la sombra pintada a mano y ya
        no hacen falta; la sombra de DWM se dibuja fuera del rectángulo de la ventana.

        El degradado se queda —es la identidad de la paleta— pero baja de opaco (#FD, #FB) a #B8,
        que es lo que deja pasar el desenfoque de detrás. Sin esa bajada el acrílico está aplicado
        y no se ve, que es exactamente el fallo que costó una tarde en el piloto.
    -->
    <Border x:Name="RootBorder"
            Padding="12"
            RenderTransformOrigin="0.5,0"
            BorderThickness="1"
            Opacity="0"
            SnapsToDevicePixels="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F2111620" Offset="0" />
                <GradientStop Color="#F2151B27" Offset="0.64" />
                <GradientStop Color="#F21B1826" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#70FFFFFF" Offset="0" />
                <GradientStop Color="#1FFFFFFF" Offset="0.42" />
                <GradientStop Color="#4A8B6CFF" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="PaletteScale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="PaletteTranslate" Y="-8" />
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="11,9"
                    Background="#B20D121B"
                    BorderBrush="#2DFFFFFF"
                    BorderThickness="1"
                    CornerRadius="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="46"
                            Height="46"
                            Margin="0,0,12,0"
                            VerticalAlignment="Top"
                            Background="{DynamicResource BrushAccentSoft}"
                            BorderBrush="{DynamicResource BrushAccentBorder}"
                            BorderThickness="1"
                            CornerRadius="15">
                        <a11y:DecorativeMark x:Name="PaletteMark"
                                        Focusable="False"
                                        Width="26"
                                        Height="26"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RenderTransformOrigin="0.5,0.5"
                                        Style="{StaticResource SakuraFlowerMarkStyle}">
                            <a11y:DecorativeMark.RenderTransform>
                                <RotateTransform x:Name="PaletteMarkRotation" />
                            </a11y:DecorativeMark.RenderTransform>
                        </a11y:DecorativeMark>
                    </Border>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBox x:Name="PromptTextBox"
                                 AutomationProperties.Name="Escribe una acción o pregunta"
                                 MinHeight="48"
                                 MaxHeight="104"
                                 Padding="1,8"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource BrushTextPrimary}"
                                 CaretBrush="{DynamicResource BrushAccent}"
                                 FontSize="{DynamicResource FontSizeTitle2}"
                                 FontWeight="Normal"
                                 TextChanged="PromptTextBox_TextChanged"
                                 SelectionBrush="{DynamicResource BrushAccentSoft}" />
                        <TextBlock x:Name="PlaceholderText"
                                   Text="Escribe una acción o pregunta"
                                   Margin="2,11,0,0"
                                   VerticalAlignment="Top"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   FontSize="{DynamicResource FontSizeTitle2}"
                                   IsHitTestVisible="False" />
                    </Grid>

                    <Border Grid.Column="2"
                            Margin="9,11,4,0"
                            Padding="9,4,9,5"
                            VerticalAlignment="Top"
                            BorderBrush="#30FFFFFF"
                            BorderThickness="1,1,1,2"
                            Background="{DynamicResource BrushSurfaceRaised}"
                            CornerRadius="9">
                        <TextBlock Text="Esc"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   FontSize="{DynamicResource FontSizeCaption}" />
                    </Border>

                    <Button AutomationProperties.Name="Movimiento y apariencia" Grid.Column="3"
                            x:Name="CustomizeButton"
                            Margin="4,3,0,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource PaletteIconButtonStyle}"
                            ToolTip="Movimiento y apariencia"
                            Click="CustomizeButton_Click">
                        <Path Width="18"
                              Height="18"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="{StaticResource IconSakuraSettings}" />
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    x:Name="ExpandedSurface"
                    Margin="0,10,0,0"
                    Padding="7"
                    Background="#B20F141E"
                    BorderBrush="#2CFFFFFF"
                    BorderThickness="1"
                    CornerRadius="20"
                    Visibility="Collapsed"
                    Opacity="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox AutomationProperties.Name="Sugerencias de acciones" x:Name="SuggestionsList"
                             MaxHeight="318"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource SuggestionItemStyle}"
                             PreviewMouseLeftButtonDown="SuggestionsList_PreviewMouseLeftButtonDown"
                             MouseDoubleClick="SuggestionsList_MouseDoubleClick"
                             SelectionChanged="SuggestionsList_SelectionChanged"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="38"
                                            Height="38"
                                            Background="#66222938"
                                            BorderBrush="#20FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource RadiusMedium}">
                                        <a11y:DecorativeText Text="{Binding Glyph}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource BrushAccent}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   FontWeight="SemiBold" />
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="12,0,11,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Margin="0,3,0,0"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Padding="9,5"
                                            VerticalAlignment="Center"
                                            Background="#72222938"
                                            CornerRadius="9"
                                            Visibility="{Binding ShortcutVisibility}">
                                        <TextBlock Text="{Binding ShortcutHint}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="{DynamicResource FontSizeCaption}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--
                        2026-09-14 — el pie en dos filas: el estado y el tiempo arriba, y los atajos como
                        teclas debajo, en un panel que salta de línea. Antes eran dos frases largas en
                        columnas que se pisaban: «Shift + Enter nueva lín» chocaba con «Ctrl + Enter».
                    -->
                    <Grid Grid.Row="1" Margin="12,9,12,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="InputModeDot"
                                     Width="6"
                                     Height="6"
                                     Margin="0,0,7,0"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource BrushTextTertiary}" />
                            <TextBlock x:Name="InputModeText"
                                       Text="Escribe para buscar o preguntar"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       FontSize="{DynamicResource FontSizeCaption}" />
                        </StackPanel>

                        <TextBlock x:Name="TimingText"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushTextTertiary}"
                                   FontSize="{DynamicResource FontSizeCaption}" />

                        <ItemsControl x:Name="KeyHintItems"
                                      Grid.Row="1"
                                      Grid.ColumnSpan="2"
                                      Margin="0,8,0,0"
                                      Focusable="False"
                                      AutomationProperties.Name="Atajos de la paleta">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,14,4" Orientation="Horizontal">
                                        <ItemsControl ItemsSource="{Binding KeyParts}" Style="{StaticResource CompactKeycapsStyle}" />
                                        <TextBlock Text="{Binding Action}"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource BrushTextTertiary}"
                                                   FontSize="{DynamicResource FontSizeCaption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    x:Name="CustomizationSurface"
                    Margin="0,10,0,0"
                    Padding="14"
                    Background="#E0181E29"
                    BorderBrush="#34FFFFFF"
                    BorderThickness="1"
                    CornerRadius="19"
                    Visibility="Collapsed"
                    Opacity="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Movimiento"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource FontSizeBody}" />
                            <TextBlock Text="Sutil por defecto; cambia la sensación sin recargar Sakura."
                                       Margin="0,3,0,0"
                                       Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <CheckBox AutomationProperties.Name="Reducir movimiento" Grid.Column="1"
                                  x:Name="ReduceMotionCheckBox"
                                  Content="Reducir movimiento"
                                  VerticalAlignment="Center"
                                  Checked="ReduceMotionCheckBox_Changed"
                                  Unchecked="ReduceMotionCheckBox_Changed" />
                    </Grid>

                    <WrapPanel Grid.Row="1" Margin="0,13,0,0">
                        <Button AutomationProperties.Name="Fluido" x:Name="FluidMotionButton"
                                Tag="Fluid"
                                Style="{StaticResource MotionChipStyle}"
                                Content="Fluido"
                                Click="MotionPresetButton_Click" />
                        <Button AutomationProperties.Name="Rápido" x:Name="SnappyMotionButton"
                                Tag="Snappy"
                                Style="{StaticResource MotionChipStyle}"
                                Content="Rápido"
                                Click="MotionPresetButton_Click" />
                        <Button AutomationProperties.Name="Calmo" x:Name="CalmMotionButton"
                                Tag="Calm"
                                Style="{StaticResource MotionChipStyle}"
                                Content="Calmo"
                                Click="MotionPresetButton_Click" />
                        <Button AutomationProperties.Name="Sin movimiento" x:Name="NoMotionButton"
                                Tag="None"
                                Style="{StaticResource MotionChipStyle}"
                                Content="Sin movimiento"
                                Click="MotionPresetButton_Click" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
