<Window x:Class="Nexo.App.SakuraPillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a11y="clr-namespace:Nexo.App.Views.Controls"
        AutomationProperties.Name="Solicitud ambiental de Sakura"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Visibility="Collapsed">
    <!--
        Diseño D4 — Sakura Pill Host. Ventana ambiental que muestra el ciclo de vida de una
        solicitud (Escuchando/Pensando/Resultado/Error) sin robar el foco de la ventana con la que
        el usuario está trabajando. Igual que CapsuleWindow, marca WS_EX_NOACTIVATE +
        WS_EX_TOOLWINDOW en OnSourceInitialized (code-behind); a diferencia de CapsuleWindow (un
        aviso transitorio que se autodescarta), esta ventana admite interacción real (Cancelar,
        Deshacer, acciones rápidas) mientras sigue sin activarse ni robar el foco.
    -->
    <Border x:Name="PillBorder"
            Padding="16,14"
            CornerRadius="22"
            Background="{DynamicResource BrushSurfaceRaised}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Direction="270"
                              ShadowDepth="8"
                              Opacity="0.38"
                              Color="#000000" />
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="PillTranslate" Y="0" />
        </Border.RenderTransform>

        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="30"
                        Height="30"
                        CornerRadius="15"
                        Background="{DynamicResource BrushAccentSoft}"
                        VerticalAlignment="Top">
                    <a11y:DecorativeMark Focusable="False" Width="17"
                                    Height="17"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource BrushAccent}"
                                    Style="{StaticResource SakuraFlowerMarkStyle}" />
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,6,0">
                    <TextBlock x:Name="StatusTextBlock"
                               Text="Escuchando…"
                               FontSize="{DynamicResource FontSizeCaption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextSecondary}" />
                    <!--
                        Diseño D7 — mientras la respuesta se escribe, este bloque es el que crece.
                        Se limita la altura y se permite desplazamiento para que una respuesta larga
                        no estire la píldora fuera de la pantalla.
                    -->
                    <ScrollViewer Focusable="True" AutomationProperties.Name="Respuesta: desplazar" x:Name="ShortTextScroller"
                                  MaxHeight="220"
                                  Margin="0,3,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="ShortTextBlock"
                                   Text=""
                                   FontSize="{DynamicResource FontSizeCallout}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrushTextPrimary}" />
                    </ScrollViewer>
                    <TextBlock x:Name="ErrorTextBlock"
                               Margin="0,3,0,0"
                               Text=""
                               FontSize="{DynamicResource FontSizeFootnote}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushDanger}"
                               Visibility="Collapsed" />
                </StackPanel>

                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Width="24"
                        Height="24"
                        Padding="0"
                        VerticalAlignment="Top"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Cerrar"
                        AutomationProperties.Name="Cerrar la solicitud ambiental"
                        Click="CloseButton_Click">
                    <a11y:DecorativeText Text="&#10005;" FontSize="{DynamicResource FontSizeCaption}" HorizontalAlignment="Center" />
                </Button>
            </Grid>

            <TextBlock x:Name="ExpandedTextBlock"
                       Margin="44,8,0,0"
                       Text=""
                       FontSize="{DynamicResource FontSizeFootnote}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       Visibility="Collapsed" />

            <StackPanel x:Name="QuickActionsPanel"
                        Margin="44,10,0,0"
                        Orientation="Horizontal"
                        Visibility="Collapsed" />

            <StackPanel x:Name="FooterPanel"
                        Margin="44,10,0,0"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                <Button x:Name="ExpandToggleButton" Content="Expandir"
                        AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,4"
                        FontSize="{DynamicResource FontSizeFootnote}"
                        Click="ExpandToggleButton_Click"
                        Visibility="Collapsed" />
                <Button x:Name="UndoButton"
                        Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,4"
                        FontSize="{DynamicResource FontSizeFootnote}"
                        Content="Deshacer"
                        AutomationProperties.Name="Deshacer la última solicitud ambiental"
                        Click="UndoButton_Click"
                        Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
