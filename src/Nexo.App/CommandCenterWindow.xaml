<Window x:Class="Nexo.App.CommandCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a11y="clr-namespace:Nexo.App.Views.Controls"
        Title="Sakura Command Center"
        Width="640"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated"
        SourceInitialized="Window_SourceInitialized"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.Name="Centro de comandos de Sakura">

    <!--
        2026-09-15 — el mismo marco que la paleta de Ctrl + Espacio: cristal transparente con esquinas
        propias y un degradado casi opaco. Con el acrílico de DWM las esquinas eran las casi rectas de
        Windows. La diferencia con la paleta está en el icono: aquí no hay IA, así que en vez de la
        flor va el símbolo de comandos, y cada fila lleva el icono de su sección.
    -->
    <Border x:Name="Surface"
            Padding="12"
            RenderTransformOrigin="0.5,0"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F2111620" Offset="0" />
                <GradientStop Color="#F2151B27" Offset="0.64" />
                <GradientStop Color="#F21B1826" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#70FFFFFF" Offset="0" />
                <GradientStop Color="#1FFFFFFF" Offset="0.42" />
                <GradientStop Color="#4A8B6CFF" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="SurfaceScale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="SurfaceTranslate" Y="0" />
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Campo de búsqueda -->
            <Border Grid.Row="0"
                    Padding="9,8"
                    Background="#B20D121B"
                    BorderBrush="#2DFFFFFF"
                    BorderThickness="1"
                    CornerRadius="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="40"
                            Height="40"
                            Background="{DynamicResource BrushAccentSoft}"
                            BorderBrush="{DynamicResource BrushAccentBorder}"
                            BorderThickness="1"
                            CornerRadius="13">
                        <Path x:Name="SearchIcon"
                              Width="18"
                              Height="18"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5"
                              Stretch="Uniform"
                              Data="{StaticResource IconCommandPalette}"
                              Stroke="{DynamicResource BrushAccent}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SearchIconRotation" />
                            </Path.RenderTransform>
                        </Path>
                    </Border>

                    <Grid Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock x:Name="SearchHintText"
                                   Margin="2,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="Busca una acción…"
                                   FontSize="{DynamicResource FontSizeTitle3}"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource BrushTextTertiary}" />
                        <!-- Sin el relleno del estilo general: con él el texto no cabía en 40 px, salía la barra de desplazamiento y lo escrito empezaba más a la derecha que el texto de ayuda. -->
                        <TextBox x:Name="SearchBox"
                                 Height="40"
                                 Padding="0"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Disabled"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="{DynamicResource FontSizeTitle3}"
                                 Foreground="{DynamicResource BrushTextPrimary}"
                                 CaretBrush="{DynamicResource BrushAccent}"
                                 TextChanged="SearchBox_TextChanged"
                                 AutomationProperties.Name="Buscar una acción"
                                 AutomationProperties.HelpText="Escribe para filtrar; usa las flechas para elegir y Enter para ejecutar." />
                    </Grid>

                    <Border Grid.Column="2"
                            Margin="9,0,4,0"
                            Padding="9,4,9,5"
                            VerticalAlignment="Center"
                            Background="#1FFFFFFF"
                            BorderBrush="#30FFFFFF"
                            BorderThickness="1,1,1,2"
                            CornerRadius="9">
                        <TextBlock Text="Esc"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Resultados -->
            <ListBox x:Name="ResultsList"
                     Grid.Row="1"
                     Margin="0,10,0,0"
                     MaxHeight="360"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Focusable="True"
                     MouseLeftButtonUp="ResultsList_MouseLeftButtonUp"
                     AutomationProperties.Name="Resultados">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemSurface"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="10,8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemSurface"
                                                    Property="Background"
                                                    Value="#14FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemSurface"
                                                    Property="Background"
                                                    Value="{DynamicResource BrushAccentSoft}" />
                                            <Setter TargetName="ItemSurface"
                                                    Property="BorderBrush"
                                                    Value="{DynamicResource BrushAccentBorder}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="ItemSurface" Property="Opacity" Value="0.5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="38"
                                    Height="38"
                                    VerticalAlignment="Center"
                                    Background="#66222938"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Path Width="17"
                                      Height="17"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      Data="{Binding IconData}"
                                      Stroke="{DynamicResource BrushAccent}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextPrimary}" />
                                    <Border Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Background="#14FFFFFF"
                                            CornerRadius="8"
                                            Padding="7,1,7,2">
                                        <TextBlock Text="{Binding CategoryLabel}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextTertiary}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}"
                                           Margin="0,3,0,0"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource BrushTextSecondary}" />
                            </StackPanel>

                            <ItemsControl Grid.Column="2"
                                          ItemsSource="{Binding ShortcutParts}"
                                          Visibility="{Binding ShortcutVisibility}"
                                          Style="{StaticResource CompactKeycapsStyle}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Estado vacío -->
            <StackPanel Grid.Row="1"
                        Margin="0,26,0,18"
                        HorizontalAlignment="Center"
                        Visibility="{Binding Visibility, ElementName=EmptyStateText}">
                <a11y:DecorativeMark Focusable="False"
                                     Width="26"
                                     Height="26"
                                     Opacity="0.7"
                                     Style="{StaticResource SakuraFlowerMarkStyle}" />
                <TextBlock x:Name="EmptyStateText"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed"
                           FontSize="{DynamicResource FontSizeCallout}"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           Text="No hay ninguna acción que coincida." />
            </StackPanel>

            <!-- Pie con ayuda de teclado -->
            <Grid Grid.Row="2" Margin="10,10,10,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ItemsControl x:Name="KeyHintItems"
                              Focusable="False"
                              AutomationProperties.Name="Atajos del centro de comandos">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,14,0" Orientation="Horizontal">
                                <ItemsControl ItemsSource="{Binding KeyParts}" Style="{StaticResource CompactKeycapsStyle}" />
                                <TextBlock Text="{Binding Action}"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrushTextTertiary}"
                                           FontSize="{DynamicResource FontSizeCaption}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Margin="6,0,0,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeCaption}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource BrushWarning}"
                           Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Border>
</Window>
