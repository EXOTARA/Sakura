<Window x:Class="Nexo.App.RecordingIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sakura grabando"
        AutomationProperties.Name="Grabación de pantalla en curso"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <!--
        2026-09-15 — el aviso de que se está grabando: una píldora arriba en el centro con el punto
        rojo, el tiempo y el botón para parar. Se excluye de la captura (WDA_EXCLUDEFROMCAPTURE), así
        que se ve en la pantalla pero no sale en el vídeo.
    -->
    <Border x:Name="Body"
            Margin="16"
            Padding="12,6,6,6"
            CornerRadius="20"
            Background="#F0141019"
            BorderBrush="#40FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.4" Color="{DynamicResource ColorShadow}" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="10"
                     Height="10"
                     VerticalAlignment="Center"
                     RenderTransformOrigin="0.5,0.5"
                     Fill="{DynamicResource BrushDanger}">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="DotScale" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <TextBlock x:Name="ElapsedText"
                       Margin="9,0,12,0"
                       VerticalAlignment="Center"
                       Text="00:00"
                       FontWeight="SemiBold"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       Foreground="{DynamicResource BrushTextPrimary}" />
            <Button x:Name="StopButton"
                    Padding="12,4"
                    Content="Parar"
                    AutomationProperties.Name="Parar la grabación"
                    Style="{StaticResource SoftChipButtonStyle}"
                    Click="StopButton_Click" />
        </StackPanel>
    </Border>
</Window>
