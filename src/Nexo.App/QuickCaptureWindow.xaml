<Window x:Class="Nexo.App.QuickCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apuntar en Sakura"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
    <!--
        2026-09-16 — Alt+Shift+N: apuntar algo desde cualquier aplicación sin abrir Sakura. Una línea,
        Enter y se va. Lo que se entendió (fecha, importante) se ve antes de guardar.
    -->
    <Border x:Name="Card"
            Margin="24"
            Padding="16,12"
            CornerRadius="22"
            Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            RenderTransformOrigin="0.5,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" Color="Black" />
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" />
        </Border.RenderTransform>
        <StackPanel>
            <TextBlock Text="APUNTAR"
                       FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushAccent}" />
            <Grid Margin="0,6,0,0">
                <TextBox x:Name="LineTextBox"
                         Style="{StaticResource CompactTextBoxStyle}"
                         AutomationProperties.Name="Apuntar una tarea"
                         AutomationProperties.HelpText="Escribe la tarea como la dirías. Enter guarda, Escape cierra."
                         TextChanged="LineTextBox_TextChanged"
                         PreviewKeyDown="LineTextBox_PreviewKeyDown" />
                <TextBlock x:Name="Placeholder"
                           Margin="13,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Text="«llamar al dentista mañana a las 10»"
                           Style="{StaticResource MutedTextStyle}" />
            </Grid>
            <TextBlock x:Name="PreviewText"
                       Margin="2,6,0,0"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Style="{StaticResource MutedTextStyle}"
                       Text="Enter guarda · Esc cierra" />
        </StackPanel>
    </Border>
</Window>
