<Window x:Class="Nexo.App.VisionTargetPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a11y="clr-namespace:Nexo.App.Views.Controls"
        Title="Elegir qué verá Sakura"
        Width="520"
        Height="560"
        MinWidth="440"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}"
        Foreground="{StaticResource BrushTextPrimary}"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        SourceInitialized="Window_SourceInitialized">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="HeaderPanel">
            <StackPanel Orientation="Horizontal">
                <a11y:DecorativeMark Focusable="False"
                                     Width="22"
                                     Height="22"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center"
                                     Style="{StaticResource SakuraFlowerMarkStyle}" />
                <TextBlock Text="¿Qué quieres mostrarle a Sakura?"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeTitle2}"
                           FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Margin="0,6,0,14"
                       Text="La captura se muestra antes de enviarse y no se guarda en el historial."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource BrushTextSecondary}" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="8"
                CornerRadius="20"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                Background="{StaticResource BrushSurface}">
            <ListBox AutomationProperties.Name="Ventanas y monitores disponibles" x:Name="TargetsList"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{StaticResource BrushTextPrimary}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MouseDoubleClick="TargetsList_MouseDoubleClick">
                <!-- 2026-09-15 — la selección con el acento y esquinas redondas, no la franja azul de Windows. -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemSurface"
                                            Padding="8,4"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource BrushAccentSoft}" />
                                            <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{DynamicResource BrushAccentBorder}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32"
                                    Height="32"
                                    CornerRadius="10"
                                    Background="#66222938"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1">
                                <Path x:Name="KindIcon"
                                      Width="16"
                                      Height="16"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      Data="{StaticResource IconSidebarPanel}"
                                      Stroke="{DynamicResource BrushAccent}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,2,0,0"
                                           Text="{Binding Subtitle}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           FontSize="{DynamicResource FontSizeFootnote}" />
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Monitor">
                                <Setter TargetName="KindIcon" Property="Data" Value="{StaticResource IconSakuraSystem}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Text="No se muestran gestores de contraseñas ni ventanas de seguridad."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource BrushTextSecondary}"
                       FontSize="{DynamicResource FontSizeFootnote}" />
            <Button AutomationProperties.Name="Cancelar" Grid.Column="1"
                    Margin="12,0,0,0"
                    Padding="14,8"
                    Content="Cancelar"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True" Click="CancelButton_Click" />
            <Button AutomationProperties.Name="Capturar" Grid.Column="2"
                    Margin="10,0,0,0"
                    Padding="14,8"
                    Content="Capturar"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True" Click="CaptureButton_Click" />
        </Grid>
    </Grid>
</Window>
