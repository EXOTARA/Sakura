<Window x:Class="Nexo.App.AnswerPillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a11y="clr-namespace:Nexo.App.Views.Controls"
        AutomationProperties.Name="Respuesta de Sakura"
        xmlns:pill="clr-namespace:Nexo.App.Views.Controls"
        Width="480"
        Height="156"
        MinHeight="132"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <!--
        Diseño D40 — el margen deja sitio a la sombra dentro de la ventana. Sin él, una ventana del
        tamaño exacto del contenido recorta la sombra en recto y deja un canto gris a un lado, que
        es el defecto que se vio en el panel de mandos.
    -->
    <!--
        Diseño D79 — la píldora es una píldora, no un rectángulo con las esquinas suaves.

        Llevaba un radio fijo de 24 sobre un borde que nunca baja de 72 de alto, así que sus
        extremos nunca fueron semicírculos: eran esquinas redondeadas y los lados salían rectos.
        Se llama píldora y no lo parecía.

        El radio sigue ahora a la mitad del alto, con tope: a su tamaño habitual es una píldora de
        verdad, y cuando la respuesta la hace crecer se vuelve más alta en vez de más redonda. Sin
        el tope, una respuesta larga la convertiría en un óvalo con el texto metido en la curva.

        El tope es 36 porque 36 es la mitad del alto mínimo: la forma compacta —la que se ve casi
        siempre— es exactamente la píldora, y crecer no la deforma.
    -->
    <Border x:Name="PillBorder"
            Margin="30"
            Padding="22,14"
            pill:PillCorner.IsPill="True"
            pill:PillCorner.MaxRadius="36"
            Background="{DynamicResource BrushSurfaceRaised}"
            BorderBrush="{DynamicResource BrushAccentBorder}"
            BorderThickness="1"
            Opacity="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              Direction="270"
                              ShadowDepth="10"
                              Opacity="0.42"
                              Color="{DynamicResource ColorShadow}" />
        </Border.Effect>
        <!--
            El contenido se mide con este StackPanel para calcular a qué altura crecer. Va anclado
            arriba: si se centrara, el texto ya escrito se desplazaría hacia abajo con cada trozo
            nuevo que llega, y leer algo que se mueve mientras se lee es peor que esperar.
        -->
        <Grid x:Name="ContentPanel" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderRow" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <a11y:DecorativeMark Focusable="False" Grid.Column="0"
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource BrushAccent}"
                                Style="{StaticResource SakuraFlowerMarkStyle}" />

                <TextBlock x:Name="QuestionText"
                           Grid.Column="1"
                           Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeFootnote}"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock x:Name="HintText"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource BrushTextTertiary}"
                           Text="Esc" />
            </Grid>

            <!--
                2026-09-15 — mientras Sakura piensa, el cargador de pétalos en vez de la palabra sola
                (Adler, con un vídeo de cargadores). Desaparece en cuanto llega la primera palabra.
            -->
            <StackPanel x:Name="ThinkingPanel"
                        Grid.Row="1"
                        Margin="0,12,0,2"
                        Orientation="Horizontal">
                <pill:SakuraLoader VerticalAlignment="Center" />
                <TextBlock x:Name="ThinkingText"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="Pensando…"
                           FontSize="{DynamicResource FontSizeFootnote}"
                           Foreground="{DynamicResource BrushTextSecondary}" />
            </StackPanel>

            <!--
                2026-09-15 — la respuesta se dibuja con formato desde la primera palabra y va saliendo
                a ritmo parejo (StreamingTextPacer), en vez de enseñar el texto crudo a trozos y
                cambiarlo por el formateado al final: ese cambio y las ráfagas del modelo eran los
                «tirones» que vio Adler. Si no cabe, se desplaza con la rueda.
            -->
            <ScrollViewer x:Name="AnswerScroll"
                          Grid.Row="1"
                          Margin="0,10,0,0"
                          Focusable="False"
                          Visibility="Collapsed"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          pill:ScrollEdgeFade.IsEnabled="True">
                <ContentControl x:Name="AnswerRich"
                                Focusable="False"
                                IsTabStop="False" />
            </ScrollViewer>

            <!--
                En su propia fila y no debajo del texto dentro de una pila: cuando la respuesta
                llenaba la píldora, este aviso quedaba fuera del recorte. Es decir, la única pista
                de que el texto seguía era justamente la que no se veía.
            -->
            <Button x:Name="OpenInSakuraText"
                       Style="{StaticResource LinkButtonStyle}"
                       AutomationProperties.Name="Ver la conversación en Sakura"
                       Grid.Row="2"
                       Margin="0,10,0,0"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource BrushAccent}"
                       Content="Ver la conversación en Sakura" />

            <!--
                2026-09-15 — seguir la conversación aquí mismo (Adler: «poder decirle a ver, pásame los
                links, y que te los dé en esa misma píldora»). Botones para lo más habitual y un cuadro
                para escribir. Aparecen cuando la respuesta ya terminó de salir.
            -->
            <StackPanel x:Name="FollowUpPanel"
                        Grid.Row="3"
                        Margin="0,12,0,0"
                        Visibility="Collapsed">
                <ItemsControl x:Name="FollowUpChips" Focusable="False" AutomationProperties.Name="Seguir con la respuesta">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,6,6"
                                    Content="{Binding Label}"
                                    ToolTip="{Binding Prompt}"
                                    AutomationProperties.Name="{Binding Label}"
                                    Style="{StaticResource SoftChipButtonStyle}"
                                    Click="FollowUpChip_Click" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,2,0,0"
                        Padding="12,2,4,2"
                        CornerRadius="18"
                        Background="#14FFFFFF"
                        BorderBrush="#26FFFFFF"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FollowUpHint"
                                   Margin="2,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Text="Sigue preguntando…"
                                   FontSize="{DynamicResource FontSizeFootnote}"
                                   Foreground="{DynamicResource BrushTextTertiary}" />
                        <TextBox x:Name="FollowUpBox"
                                 MinHeight="32"
                                 Padding="0"
                                 VerticalContentAlignment="Center"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Disabled"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="{DynamicResource FontSizeFootnote}"
                                 AutomationProperties.Name="Sigue preguntando a Sakura" />
                        <Button x:Name="FollowUpSendButton"
                                Grid.Column="1"
                                Width="30"
                                Height="30"
                                Padding="0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                AutomationProperties.Name="Enviar"
                                ToolTip="Enviar"
                                Click="FollowUpSendButton_Click">
                            <Path Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Stroke="White"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="{StaticResource IconSakuraSend}" />
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
