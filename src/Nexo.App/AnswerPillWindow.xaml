<Window x:Class="Nexo.App.AnswerPillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a11y="clr-namespace:Nexo.App.Views.Controls"
        AutomationProperties.Name="Respuesta de Sakura"
        xmlns:pill="clr-namespace:Nexo.App.Views.Controls"
        Width="480"
        Height="156"
        MinHeight="132"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <!--
        Diseño D40 — el margen deja sitio a la sombra dentro de la ventana. Sin él, una ventana del
        tamaño exacto del contenido recorta la sombra en recto y deja un canto gris a un lado, que
        es el defecto que se vio en el panel de mandos.
    -->
    <!--
        Diseño D79 — la píldora es una píldora, no un rectángulo con las esquinas suaves.

        Llevaba un radio fijo de 24 sobre un borde que nunca baja de 72 de alto, así que sus
        extremos nunca fueron semicírculos: eran esquinas redondeadas y los lados salían rectos.
        Se llama píldora y no lo parecía.

        El radio sigue ahora a la mitad del alto, con tope: a su tamaño habitual es una píldora de
        verdad, y cuando la respuesta la hace crecer se vuelve más alta en vez de más redonda. Sin
        el tope, una respuesta larga la convertiría en un óvalo con el texto metido en la curva.

        El tope es 36 porque 36 es la mitad del alto mínimo: la forma compacta —la que se ve casi
        siempre— es exactamente la píldora, y crecer no la deforma.
    -->
    <Border x:Name="PillBorder"
            Margin="30"
            Padding="22,14"
            pill:PillCorner.IsPill="True"
            pill:PillCorner.MaxRadius="36"
            Background="{DynamicResource BrushSurfaceRaised}"
            BorderBrush="{DynamicResource BrushAccentBorder}"
            BorderThickness="1"
            Opacity="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              Direction="270"
                              ShadowDepth="10"
                              Opacity="0.42"
                              Color="#000000" />
        </Border.Effect>
        <!--
            El contenido se mide con este StackPanel para calcular a qué altura crecer. Va anclado
            arriba: si se centrara, el texto ya escrito se desplazaría hacia abajo con cada trozo
            nuevo que llega, y leer algo que se mueve mientras se lee es peor que esperar.
        -->
        <Grid x:Name="ContentPanel" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderRow" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <a11y:DecorativeMark Focusable="False" Grid.Column="0"
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource BrushAccent}"
                                Style="{StaticResource SakuraFlowerMarkStyle}" />

                <TextBlock x:Name="QuestionText"
                           Grid.Column="1"
                           Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeFootnote}"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock x:Name="HintText"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource BrushTextTertiary}"
                           Text="Esc" />
            </Grid>

            <TextBlock x:Name="AnswerText"
                       Grid.Row="1"
                       Margin="0,10,0,0"
                       FontSize="{DynamicResource FontSizeCallout}"
                       LineHeight="20"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource BrushTextPrimary}" />

            <!--
                En su propia fila y no debajo del texto dentro de una pila: cuando la respuesta
                llenaba la píldora, este aviso quedaba fuera del recorte. Es decir, la única pista
                de que el texto seguía era justamente la que no se veía.
            -->
            <Button x:Name="OpenInSakuraText"
                       Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Left"
                       AutomationProperties.Name="Pulsa aquí para verla completa en Sakura"
                       Grid.Row="2"
                       Margin="0,10,0,0"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource BrushAccent}"
                       Content="Pulsa aquí para verla completa en Sakura" />
        </Grid>
    </Border>
</Window>
