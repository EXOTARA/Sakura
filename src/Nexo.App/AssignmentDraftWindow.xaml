<Window x:Class="Nexo.App.AssignmentDraftWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Borrador de tarea"
        Width="500"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <!--
        2026-09-16 — Borrador de tarea, fase 4: antes de pedir el borrador se confirma el tipo y los
        datos de la portada, en su propia ventana (decidido con Adler). Si parece un examen, primero
        se avisa (fase 5).
    -->
    <Border Margin="24"
            Padding="18,16"
            CornerRadius="22"
            Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="BORRADOR DE TAREA"
                       FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushAccent}" />

            <!-- Aviso de examen -->
            <Border x:Name="ExamNotice"
                    Margin="0,10,0,0"
                    Padding="14,12"
                    CornerRadius="16"
                    Background="{DynamicResource BrushSurfaceRaised}"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Esto parece un examen"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}"
                               Text="Con un examen Sakura no hace borradores. Puede explicarte cómo se resuelve ese tipo de ejercicio con otro ejemplo, para que lo hagas tú." />
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <Button Content="Explícame cómo se resuelve"
                                Padding="14,7"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Tutor_Click" />
                        <Button Margin="7,0,0,0"
                                Content="No es un examen"
                                Padding="14,7"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="NotAnExam_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel x:Name="FormPanel">
                <TextBlock Margin="0,10,0,6" Text="¿Qué tipo de trabajo es?" FontWeight="SemiBold" />
                <WrapPanel x:Name="KindsPanel" />

                <TextBlock Margin="0,12,0,6" Text="Sobre la actividad (se lee de la tarea si lo dejas vacío)" FontWeight="SemiBold" TextWrapping="Wrap" />
                <UniformGrid x:Name="ActivityFields" Columns="1" />

                <Grid Margin="0,8,0,6">
                    <TextBlock Text="Tus datos para la portada" FontWeight="SemiBold" />
                    <Button x:Name="ShowPersonalButton"
                            HorizontalAlignment="Right"
                            Content="Añadir mis datos"
                            Visibility="Collapsed"
                            Style="{StaticResource SoftChipButtonStyle}"
                            Click="ShowPersonal_Click" />
                </Grid>
                <StackPanel x:Name="PersonalPanel">
                    <UniformGrid x:Name="PersonalFields" Columns="2" />
                    <CheckBox x:Name="RememberCheckBox"
                              Margin="0,2,0,0"
                              Content="Recordar mis datos en este equipo" />
                    <TextBlock Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Style="{StaticResource MutedTextStyle}"
                               Text="Lo que dejes vacío saldrá como hueco resaltado ([Nombre], [Matrícula]…) para que lo completes." />
                </StackPanel>

                <Grid Margin="0,14,0,0">
                    <Button HorizontalAlignment="Left"
                            Content="Cancelar"
                            Padding="14,7"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Cancel_Click" />
                    <Button HorizontalAlignment="Right"
                            Content="Hacer el borrador"
                            Padding="14,7"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Draft_Click" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
