<Window x:Class="Nexo.App.AmbientHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a11y="clr-namespace:Nexo.App.Views.Controls"
        Title="Historial de solicitudes ambientales"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown"
        SourceInitialized="Window_SourceInitialized"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.Name="Historial de solicitudes ambientales">
    <!--
        Diseño D4.4 — visor del historial que AmbientRequestManager ya persistía desde D4.1 (usado
        internamente para el archivado automático) pero que hasta ahora no tenía ninguna superficie
        visible. Ventana normal (activable), a diferencia del Sakura Pill Host: aquí el usuario abre
        el historial a propósito desde el Command Center, no es una interrupción ambiental.
    -->
    <!--
        Diseño D62 — el marco lo compone Windows: acrílico, esquinas y sombra. Sin
        AllowsTransparency la ventana la pinta la tarjeta gráfica, y la sombra deja de recalcularse
        cada vez que cambia algo dentro. La superficie no lleva radio ni trazo propios porque el
        recorte de las esquinas es de DWM y un borde nuestro se cortaría en el arco.
    -->
    <Border x:Name="Surface" Padding="0">

        <Grid Margin="18,16,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Historial de solicitudes"
                           FontSize="{DynamicResource FontSizeTitle3}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextPrimary}" />

                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Width="26"
                        Height="26"
                        Padding="0"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Cerrar"
                        AutomationProperties.Name="Cerrar historial de solicitudes"
                        Click="CloseButton_Click">
                    <a11y:DecorativeText Text="&#10005;" FontSize="{DynamicResource FontSizeCaption}" HorizontalAlignment="Center" />
                </Button>
            </Grid>

            <ScrollViewer Focusable="True" AutomationProperties.Name="Historial de solicitudes: desplazar" Grid.Row="1"
                          Margin="0,14,0,0"
                          MaxHeight="420"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl AutomationProperties.Name="Solicitudes recientes" x:Name="HistoryItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="12,10"
                                    Background="{DynamicResource BrushSurfaceRaised}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusMedium}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Prompt}"
                                                       FontSize="{DynamicResource FontSizeCallout}"
                                                       FontWeight="SemiBold"
                                                       MaxWidth="260"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource BrushTextPrimary}" />
                                            <Border Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource BrushSurface}"
                                                    CornerRadius="5"
                                                    Padding="6,2">
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                           Foreground="{DynamicResource BrushTextTertiary}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ResultText}"
                                                   Margin="0,4,0,0"
                                                   FontSize="{DynamicResource FontSizeFootnote}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Visibility="{Binding ResultVisibility}" />
                                        <TextBlock Text="{Binding TimestampText}"
                                                   Margin="0,4,0,0"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextTertiary}" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="Deshacer"
                                            Padding="8,4"
                                            FontSize="{DynamicResource FontSizeCaption}"
                                            VerticalAlignment="Top"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Visibility="{Binding UndoButtonVisibility}"
                                            Tag="{Binding Id}"
                                            Click="UndoButton_Click"
                                            AutomationProperties.Name="Deshacer esta solicitud" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyStateText"
                       Grid.Row="1"
                       Margin="0,20,0,14"
                       HorizontalAlignment="Center"
                       FontSize="{DynamicResource FontSizeCallout}"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       Text="Todavía no hay solicitudes registradas."
                       Visibility="Collapsed" />

            <Border Grid.Row="2"
                    Margin="0,12,0,0"
                    Padding="2,10,2,0"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="0,1,0,0">
                <TextBlock Text="Esc cerrar"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource BrushTextTertiary}" />
            </Border>
        </Grid>
    </Border>
</Window>
