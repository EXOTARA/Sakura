<UserControl x:Class="Nexo.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <!--
        2026-09-16 — Inicio nuevo, dirección «Burbujas» con la calma de «Calma» (elegida por Adler).

        Inicio responde una pregunta: ¿qué hago ahora? Por eso ya no hay cuatro tarjetas que solo
        informan ni tres botones de accesos: hay una burbuja «Ahora» que, al tocarla, se parte en sus
        dos opciones; dos cifras pequeñas; el resumen de ayer, que se ignora sin esfuerzo, y un rastro
        de lo que acaba de pasar. Cada bloque es un objeto aparte que entra escalonado.
    -->
    <UserControl.Resources>
        <!--
            Una burbuja: esquinas muy redondas, fondo tonal y una capa de brillo opcional (Tag). Al
            pulsarla se encoge al instante —la respuesta llega al apretar, no al soltar—.
        -->
        <Style x:Key="BubbleButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="Background" Value="#C8161D29" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Border x:Name="Surface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#1FFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="26" />
                            <Border x:Name="Glow"
                                    Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                    CornerRadius="26"
                                    IsHitTestVisible="False" />
                            <Border x:Name="Hover"
                                    Background="#0FFFFFFF"
                                    CornerRadius="26"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource BrushAccentBorder}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.975" ScaleY="0.975" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BubbleLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextTertiary}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="2">
        <StackPanel Margin="2,1,4,8">
            <Grid x:Name="HeaderBlock" Margin="2,0,2,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="GreetingText"
                               Text="Hola"
                               FontSize="{DynamicResource FontSizeTitle1}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="DateText"
                               Margin="0,4,0,0"
                               Text="hoy"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               FontSize="{DynamicResource FontSizeCallout}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Width="46"
                        Height="46"
                        Margin="12,0,0,0"
                        Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.Name="Abrir la paleta de comandos"
                        ToolTip="Abrir paleta · Ctrl + Espacio"
                        Click="CommandButton_Click">
                    <Path Width="20"
                          Height="20"
                          Stretch="Uniform"
                          Fill="{DynamicResource BrushAccent}"
                          Data="M10,1 L12.4,7.6 L19,10 L12.4,12.4 L10,19 L7.6,12.4 L1,10 L7.6,7.6 Z" />
                </Button>
            </Grid>

            <!--
                2026-09-16 — repaso de la mañana: una vez al día, solo si quedó algo de antes. Cada
                cosa se decide con un toque; al terminar, el bloque se va.
            -->
            <Border x:Name="ReviewBlock"
                    Margin="0,0,0,12"
                    Padding="16,14"
                    CornerRadius="26"
                    Background="{DynamicResource BrushSurfaceRaised}"
                    BorderBrush="{DynamicResource BrushAccentSoft}"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="ANTES DE EMPEZAR"
                               FontSize="{DynamicResource FontSizeCaption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushAccent}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="Esto quedó pendiente. ¿Qué hacemos con cada cosa?"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold" />
                    <ItemsControl x:Name="ReviewItems" Margin="0,8,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource FontSizeCaption}" Style="{StaticResource MutedTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Hoy" Tag="today" CommandParameter="{Binding TaskId}" Margin="6,0,0,0"
                                                Style="{StaticResource SoftChipButtonStyle}" Click="ReviewAction_Click"
                                                AutomationProperties.Name="Pasar a hoy" />
                                        <Button Content="Mañana" Tag="tomorrow" CommandParameter="{Binding TaskId}" Margin="6,0,0,0"
                                                Style="{StaticResource SoftChipButtonStyle}" Click="ReviewAction_Click"
                                                AutomationProperties.Name="Pasar a mañana" />
                                        <Button Content="Soltar" Tag="release" CommandParameter="{Binding TaskId}" Margin="6,0,0,0"
                                                Style="{StaticResource SoftChipButtonStyle}" Click="ReviewAction_Click"
                                                AutomationProperties.Name="Soltar" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Margin="0,12,0,0"
                            HorizontalAlignment="Right"
                            Content="Listo"
                            Padding="18,7"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="ReviewDone_Click" />
                </StackPanel>
            </Border>

            <!-- Ahora -->
            <StackPanel x:Name="NowBlock">
                <Button x:Name="NowBubble"
                        Padding="20,18,20,18"
                        Style="{StaticResource BubbleButtonStyle}"
                        AutomationProperties.Name="Ahora"
                        Click="NowBubble_Click">
                    <StackPanel>
                        <TextBlock x:Name="NowLabelText"
                                   Text="AHORA · TOCA PARA DECIDIR"
                                   Style="{StaticResource BubbleLabelStyle}" />
                        <TextBlock x:Name="NowTitleText"
                                   Margin="0,6,0,0"
                                   Text="Nada importante para hoy"
                                   FontSize="{DynamicResource FontSizeTitle2}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="NowDetailText"
                                   Margin="0,4,0,0"
                                   Text="Toca para añadir una tarea"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   FontSize="{DynamicResource FontSizeFootnote}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <!--
                    La burbuja se parte en sus dos opciones. Empieza cerrada (alto 0) y se abre con un
                    muelle; los botones se inflan un poco después, como si salieran de ella.
                -->
                <Grid x:Name="NowActions"
                      Height="0"
                      ClipToBounds="True"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="NowPrimaryButton"
                            Margin="0,8,4,0"
                            Padding="0,9"
                            Content="Empezar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            RenderTransformOrigin="0.5,0.5"
                            Click="NowPrimaryButton_Click" />
                    <Button x:Name="NowSecondaryButton"
                            Grid.Column="1"
                            Margin="4,8,0,0"
                            Padding="0,9"
                            Content="Mañana"
                            Style="{StaticResource SecondaryButtonStyle}"
                            RenderTransformOrigin="0.5,0.5"
                            Click="NowSecondaryButton_Click" />
                </Grid>
            </StackPanel>

            <!-- Las dos cifras del día -->
            <Grid x:Name="CountsBlock" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="DoneBubble"
                        Margin="0,0,5,0"
                        Style="{StaticResource BubbleButtonStyle}"
                        AutomationProperties.Name="Hechas hoy. Ir a Hoy"
                        Click="DoneBubble_Click">
                    <StackPanel>
                        <TextBlock Text="Hechas hoy" Style="{StaticResource BubbleLabelStyle}" />
                        <TextBlock x:Name="DoneText"
                                   Margin="0,3,0,0"
                                   Text="0"
                                   FontSize="{DynamicResource FontSizeTitle2}"
                                   FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                </Button>
                <Button x:Name="FocusBubble"
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        Style="{StaticResource BubbleButtonStyle}"
                        AutomationProperties.Name="Enfoque de hoy"
                        Click="FocusBubble_Click">
                    <StackPanel>
                        <TextBlock Text="Enfoque" Style="{StaticResource BubbleLabelStyle}" />
                        <TextBlock x:Name="FocusText"
                                   Margin="0,3,0,0"
                                   Text="0 min"
                                   FontSize="{DynamicResource FontSizeTitle2}"
                                   FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Ayer, solo si ayer quedó algo -->
            <StackPanel x:Name="YesterdayBlock" Margin="0,10,0,0" Visibility="Collapsed">
                <Button x:Name="YesterdayBubble"
                        Padding="18,12"
                        Style="{StaticResource BubbleButtonStyle}"
                        AutomationProperties.Name="Resumen de ayer"
                        Click="YesterdayBubble_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="¿Un resumen de ayer?"
                                       FontSize="{DynamicResource FontSizeCallout}"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="YesterdayHeadlineText"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       FontSize="{DynamicResource FontSizeFootnote}" />
                        </StackPanel>
                        <TextBlock x:Name="YesterdayChevron"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="›"
                                   FontSize="20"
                                   Foreground="{DynamicResource BrushTextTertiary}"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="YesterdayChevronRotation" Angle="0" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </Button>

                <!-- El hilo de ayer: lo que pasó, en orden, con su hora. -->
                <Border x:Name="YesterdayPanel"
                        Margin="14,10,4,2"
                        Visibility="Collapsed">
                    <Grid>
                        <Border Width="2"
                                HorizontalAlignment="Left"
                                Margin="4,6,0,6"
                                CornerRadius="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop x:Name="ThreadTop" Offset="0" Color="#E39AB4" />
                                    <GradientStop Offset="1" Color="#26E39AB4" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <ItemsControl x:Name="YesterdayItems" Margin="0,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="10"
                                                 Height="10"
                                                 Margin="0,3,12,0"
                                                 VerticalAlignment="Top"
                                                 Fill="{DynamicResource BrushSuccess}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Time}"
                                                       Foreground="{DynamicResource BrushTextTertiary}"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       Typography.NumeralAlignment="Tabular" />
                                            <TextBlock Text="{Binding Text}"
                                                       Margin="0,1,0,0"
                                                       FontSize="{DynamicResource FontSizeFootnote}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- El rastro de lo que acaba de pasar -->
            <StackPanel x:Name="TrailBlock" Margin="4,18,2,0" Visibility="Collapsed">
                <TextBlock Text="Hace un rato" Style="{StaticResource BubbleLabelStyle}" />
                <ItemsControl x:Name="TrailItems" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,6,6"
                                    Padding="10,5"
                                    CornerRadius="12"
                                    Background="#14FFFFFF"
                                    ToolTip="{Binding Detail}">
                                <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource BrushTextSecondary}">
                                    <Run Text="{Binding Title, Mode=OneWay}" />
                                    <Run Text=" · " Foreground="{DynamicResource BrushTextTertiary}" />
                                    <Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource BrushTextTertiary}" />
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
