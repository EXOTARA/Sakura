<UserControl x:Class="Nexo.App.Views.RoutinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            2026-09-16 — pasada visual con la calma de Hoy: plantillas y «Nuevo» en una línea, y cada
            atajo como una fila con ▶ delante; lo demás aparece al pasar el ratón. Antes cada tarjeta
            llevaba cuatro botones grandes y «Desactivar» salía cortado.
        -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel VerticalAlignment="Center">
                <Button Content="+ Estudiar" Tag="study" Margin="0,0,6,6" Style="{StaticResource SoftChipButtonStyle}"
                        ToolTip="Plantilla: silencia Discord, baja Spotify y empieza 25 min de enfoque" Click="TemplateButton_Click" />
                <Button Content="+ Programar" Tag="code" Margin="0,0,6,6" Style="{StaticResource SoftChipButtonStyle}"
                        ToolTip="Plantilla: abre VS Code y PowerShell, y empieza 50 min de enfoque" Click="TemplateButton_Click" />
                <Button Content="+ Descanso" Tag="rest" Margin="0,0,6,6" Style="{StaticResource SoftChipButtonStyle}"
                        ToolTip="Plantilla: activa el sonido de Discord y empieza 10 min de descanso" Click="TemplateButton_Click" />
            </WrapPanel>
            <Button Grid.Column="1"
                    VerticalAlignment="Top"
                    Content="Nuevo"
                    Padding="14,7"
                    Style="{StaticResource PrimaryButtonStyle}"
                    AutomationProperties.Name="Nuevo atajo"
                    Click="NewRoutineButton_Click" />
        </Grid>

        <TextBlock Grid.Row="1"
                   Margin="2,4,0,10"
                   Text="Di la frase o toca ▶. Solo se ejecutan acciones de una lista permitida; las sensibles se muestran antes."
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeCaption}"
                   Style="{StaticResource MutedTextStyle}" />

        <Grid Grid.Row="2">
            <ScrollViewer x:Name="ListScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl x:Name="RoutinesItemsControl" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row"
                                        Margin="0,0,0,4"
                                        Padding="10"
                                        CornerRadius="16"
                                        Background="Transparent"
                                        Opacity="{Binding RowOpacity}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="▶"
                                                Tag="{Binding Id}"
                                                Width="34"
                                                Height="34"
                                                Padding="0"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                ToolTip="Ejecutar ahora"
                                                AutomationProperties.Name="{Binding RunAutomationName}"
                                                Click="RunRoutineButton_Click" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Text="{Binding Status, Mode=OneWay}"
                                                     FontWeight="Normal"
                                                     FontSize="{DynamicResource FontSizeCaption}"
                                                     Foreground="{DynamicResource BrushTextTertiary}" />
                                            </TextBlock>
                                            <TextBlock Margin="0,2,0,0"
                                                       Text="{Binding TriggerPhrase}"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource BrushAccent}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="{Binding StepSummary}"
                                                       TextWrapping="Wrap"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       Style="{StaticResource MutedTextStyle}" />
                                            <Grid Margin="0,4,0,0">
                                                <TextBlock Text="{Binding LastExecutionText}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding LastExecutionBrush}"
                                                           FontSize="{DynamicResource FontSizeCaption}" />
                                                <StackPanel x:Name="Actions"
                                                            HorizontalAlignment="Right"
                                                            Orientation="Horizontal"
                                                            Background="{DynamicResource BrushSurfaceRaised}"
                                                            Opacity="0"
                                                            IsHitTestVisible="False">
                                                    <Button Content="{Binding ToggleLabel}"
                                                            Tag="{Binding Id}"
                                                            Margin="5,0,0,0"
                                                            Padding="9,3"
                                                            Style="{StaticResource SoftChipButtonStyle}"
                                                            AutomationProperties.Name="{Binding ToggleAutomationName}"
                                                            Click="ToggleRoutineButton_Click" />
                                                    <Button Content="Editar"
                                                            Tag="{Binding Id}"
                                                            Margin="5,0,0,0"
                                                            Padding="9,3"
                                                            Style="{StaticResource SoftChipButtonStyle}"
                                                            AutomationProperties.Name="{Binding EditAutomationName}"
                                                            Click="EditRoutineButton_Click" />
                                                    <Button Content="Eliminar"
                                                            Tag="{Binding Id}"
                                                            Margin="5,0,0,0"
                                                            Padding="9,3"
                                                            Style="{StaticResource SoftChipButtonStyle}"
                                                            AutomationProperties.Name="{Binding DeleteAutomationName}"
                                                            Click="DeleteRoutineButton_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
                                        <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                        <Setter TargetName="Actions" Property="IsHitTestVisible" Value="True" />
                                    </Trigger>
                                    <Trigger SourceName="Row" Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
                                        <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                        <Setter TargetName="Actions" Property="IsHitTestVisible" Value="True" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyStateText"
                               Text="Aún no hay atajos."
                               Margin="0,20,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="EditorScrollViewer"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="EditorTitleText"
                               Text="Nuevo atajo"
                               Style="{StaticResource SectionTitleStyle}" />

                    <TextBlock Text="Nombre" Margin="0,12,0,5" FontWeight="SemiBold" />
                    <TextBox x:Name="NameTextBox"
                             AutomationProperties.Name="Nombre del atajo" Style="{StaticResource CompactTextBoxStyle}" />

                    <TextBlock Text="Frase de activación" Margin="0,12,0,5" FontWeight="SemiBold" />
                    <TextBox x:Name="TriggerTextBox"
                             AutomationProperties.Name="Frase que dispara el atajo" Style="{StaticResource CompactTextBoxStyle}" />

                    <CheckBox x:Name="EnabledCheckBox"
                              Margin="0,12,0,0"
                              Content="Atajo activo"
                              IsChecked="True" />
                    <CheckBox x:Name="ConfirmationCheckBox"
                              Margin="0,8,0,0"
                              Content="Mostrar vista previa antes de ejecutar"
                              IsChecked="True" />

                    <TextBlock Text="Acciones" Margin="0,16,0,8" FontWeight="SemiBold" />
                    <Border Style="{StaticResource SubtleCardStyle}">
                        <StackPanel>
                            <CheckBox x:Name="OpenCodeCheckBox" Content="Abrir VS Code" />
                            <CheckBox x:Name="OpenTerminalCheckBox" Margin="0,8,0,0" Content="Abrir PowerShell" />
                            <TextBlock Text="Carpeta del proyecto" Margin="0,9,0,5" Style="{StaticResource MutedTextStyle}" />
                            <TextBox x:Name="ProjectFolderTextBox"
                                     AutomationProperties.Name="Carpeta del proyecto"
                                     Text="{}"
                                     Style="{StaticResource CompactTextBoxStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,8,0,0" Style="{StaticResource SubtleCardStyle}">
                        <StackPanel>
                            <CheckBox x:Name="SpotifyVolumeCheckBox" Content="Ajustar volumen de Spotify" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Porcentaje" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" />
                                <TextBox x:Name="SpotifyVolumeTextBox"
                                         AutomationProperties.Name="Volumen de Spotify"
                                         Grid.Column="1"
                                         Text="20"
                                         Style="{StaticResource CompactTextBoxStyle}" />
                            </Grid>
                            <CheckBox x:Name="MuteDiscordCheckBox"
                                      Margin="0,9,0,0"
                                      Content="Silenciar Discord" />
                            <CheckBox x:Name="UnmuteDiscordCheckBox"
                                      Margin="0,8,0,0"
                                      Content="Reactivar Discord" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,8,0,0" Style="{StaticResource SubtleCardStyle}">
                        <StackPanel>
                            <CheckBox x:Name="StartFocusCheckBox" Content="Iniciar sesión de enfoque" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Minutos" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" />
                                <TextBox x:Name="FocusMinutesTextBox"
                                         AutomationProperties.Name="Minutos de enfoque"
                                         Grid.Column="1"
                                         Text="50"
                                         Style="{StaticResource CompactTextBoxStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,8,0,0" Style="{StaticResource SubtleCardStyle}">
                        <StackPanel>
                            <CheckBox x:Name="StartBreakCheckBox" Content="Iniciar descanso" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Minutos" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" />
                                <TextBox x:Name="BreakMinutesTextBox"
                                         AutomationProperties.Name="Minutos de descanso"
                                         Grid.Column="1"
                                         Text="10"
                                         Style="{StaticResource CompactTextBoxStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,8,0,0" Style="{StaticResource SubtleCardStyle}">
                        <StackPanel>
                            <CheckBox x:Name="CreateTaskCheckBox" Content="Crear una tarea" />
                            <TextBox x:Name="TaskTitleTextBox"
                                     AutomationProperties.Name="Título de la tarea"
                                     Margin="0,8,0,0"
                                     Style="{StaticResource CompactTextBoxStyle}"
                                     ToolTip="Título de la tarea" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="EditorErrorText"
                               Margin="0,10,0,0"
                               Foreground="#FF7777"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />

                    <UniformGrid Columns="2" Margin="0,14,0,0">
                        <Button Content="Cancelar"
                                Margin="0,0,4,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CancelEditorButton_Click" />
                        <Button Content="Guardar"
                                Margin="4,0,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="SaveRoutineButton_Click" />
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
