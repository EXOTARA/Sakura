<UserControl x:Class="Nexo.App.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        2026-09-16 — Hoy como centro del día, con la calma de la dirección A.

        Sin contadores ni filtros: una caja para apuntar en una línea y, debajo, lo del día por
        secciones. Las acciones de cada fila aparecen al pasar el ratón o al llegar con el teclado,
        para que la lista se lea como una lista y no como una botonera.
    -->
    <UserControl.Resources>
        <Style x:Key="CheckCircleStyle" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,1,11,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource BrushTextTertiary}" StrokeThickness="1.6" />
                            <Ellipse x:Name="Fill" Margin="4" Fill="{DynamicResource BrushAccent}" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource BrushAccent}" />
                                <Setter TargetName="Fill" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource BrushAccent}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Done">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource BrushAccent}" />
                                <Setter TargetName="Fill" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowActionStyle" TargetType="Button" BasedOn="{StaticResource SoftChipButtonStyle}">
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="Transparent" CornerRadius="8" Padding="2,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- El día que se ve: hoy, o el que se tocó en el calendario -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="DayTitleText"
                           Text="Hoy"
                           FontSize="{DynamicResource FontSizeTitle3}"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="DaySubtitleText"
                           Margin="0,2,0,0"
                           Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
            <Button x:Name="BackToTodayButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="Volver a hoy"
                    Visibility="Collapsed"
                    Style="{StaticResource SoftChipButtonStyle}"
                    Click="BackToTodayButton_Click" />
        </Grid>

        <!-- Apuntar en una línea -->
        <StackPanel Grid.Row="1" Margin="0,12,0,8">
            <Grid>
                <TextBox x:Name="CaptureTextBox"
                         Style="{StaticResource CompactTextBoxStyle}"
                         Padding="12,0,40,0"
                         AutomationProperties.Name="Apuntar una tarea"
                         AutomationProperties.HelpText="Escribe la tarea como la dirías, por ejemplo: entregar el ensayo el viernes a las 5. Enter para guardar."
                         TextChanged="CaptureTextBox_TextChanged"
                         KeyDown="CaptureTextBox_KeyDown" />
                <TextBlock x:Name="CapturePlaceholder"
                           Margin="13,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Text="Apunta algo… «entregar el ensayo el viernes a las 5»"
                           Style="{StaticResource MutedTextStyle}" />
                <Button HorizontalAlignment="Right"
                        Margin="0,0,4,0"
                        Width="30"
                        Height="30"
                        FontSize="15"
                        Content="+"
                        Background="Transparent"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Más detalles: notas, hora exacta y recordatorio"
                        AutomationProperties.Name="Nueva tarea con detalles"
                        Click="NewTaskButton_Click" />
            </Grid>
            <TextBlock x:Name="CapturePreviewText"
                       Margin="12,5,0,0"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource BrushAccent}"
                       Visibility="Collapsed" />
        </StackPanel>

        <!-- Deshacer «Soltar» -->
        <Border x:Name="UndoBar"
                Grid.Row="2"
                Margin="0,0,0,8"
                Padding="12,6"
                CornerRadius="12"
                Background="{DynamicResource BrushSurfaceRaised}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UndoText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{StaticResource MutedTextStyle}" />
                <Button Grid.Column="1" Content="Deshacer" Style="{StaticResource SoftChipButtonStyle}" Click="UndoButton_Click" />
            </Grid>
        </Border>

        <Border x:Name="EditorBorder"
                Grid.Row="3"
                Style="{StaticResource SubtleCardStyle}"
                Margin="0,0,0,10"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="EditorTitleText"
                           Text="Nueva tarea"
                           FontWeight="SemiBold"
                           FontSize="{DynamicResource FontSizeBody}" />
                <Grid Margin="0,9,0,0">
                    <TextBox x:Name="TitleTextBox"
                             AutomationProperties.Name="Título de la tarea"
                             Style="{StaticResource CompactTextBoxStyle}"
                             TextChanged="EditorHint_TextChanged" />
                    <TextBlock x:Name="TitleHint"
                               Margin="13,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Text="¿Qué hay que hacer?"
                               Style="{StaticResource MutedTextStyle}" />
                </Grid>
                <!--
                    2026-09-16 — cada caja dice qué va en ella (Adler: «la barra de abajo casi no la
                    entiendo»). La fecha y la hora se escriben juntas y como se dicen, en vez del
                    calendario de Windows, que no seguía el estilo de Sakura y casi no se leía.
                -->
                <Grid Margin="0,7,0,0">
                    <TextBox x:Name="NotesTextBox"
                             AutomationProperties.Name="Notas de la tarea"
                             Height="54"
                             Style="{StaticResource PromptTextBoxStyle}"
                             AcceptsReturn="True"
                             TextChanged="EditorHint_TextChanged" />
                    <TextBlock x:Name="NotesHint"
                               Margin="13,9,0,0"
                               IsHitTestVisible="False"
                               Text="Notas (opcional)"
                               Style="{StaticResource MutedTextStyle}" />
                </Grid>

                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="WhenTextBox"
                             AutomationProperties.Name="Cuándo"
                             AutomationProperties.HelpText="Por ejemplo: hoy 5 pm, mañana, viernes 9:30 am, 20/09. Vacío si no tiene fecha."
                             Style="{StaticResource CompactTextBoxStyle}"
                             TextChanged="WhenTextBox_TextChanged" />
                    <TextBlock x:Name="WhenHint"
                               Margin="13,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Text="Cuándo: «hoy 5 pm», «viernes», «20/09»"
                               Style="{StaticResource MutedTextStyle}" />
                    <ComboBox x:Name="PriorityComboBox"
                              AutomationProperties.Name="Prioridad de la tarea"
                              Grid.Column="1"
                              Margin="7,0,0,0"
                              Height="36"
                              MinWidth="120"
                              SelectedIndex="1"
                              VerticalContentAlignment="Center"
                              ToolTip="Prioridad">
                        <ComboBoxItem Content="Baja" Tag="Low" />
                        <ComboBoxItem Content="Normal" Tag="Normal" />
                        <ComboBoxItem Content="Importante" Tag="High" />
                    </ComboBox>
                </Grid>

                <WrapPanel Margin="0,7,0,0">
                    <Button Content="Hoy" Tag="hoy" Margin="0,0,6,0" Style="{StaticResource SoftChipButtonStyle}" Click="WhenChip_Click" />
                    <Button Content="Mañana" Tag="mañana" Margin="0,0,6,0" Style="{StaticResource SoftChipButtonStyle}" Click="WhenChip_Click" />
                    <Button Content="Sin fecha" Tag="" Margin="0,0,10,0" Style="{StaticResource SoftChipButtonStyle}" Click="WhenChip_Click" />
                    <TextBlock x:Name="WhenPreviewText"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushAccent}" />
                </WrapPanel>

                <CheckBox x:Name="ReminderCheckBox"
                          Margin="0,8,0,0"
                          Content="Avisarme a esa hora" />
                <TextBlock x:Name="EditorErrorText"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource BrushWarning}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <Grid Margin="0,9,0,0">
                    <Button x:Name="DeleteTaskButton"
                            HorizontalAlignment="Left"
                            Content="Eliminar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="13,8"
                            AutomationProperties.Name="Eliminar tarea"
                            Click="DeleteTaskButton_Click" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="13,8"
                                Click="CancelEditorButton_Click" />
                        <Button Margin="7,0,0,0"
                                Content="Guardar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="13,8"
                                Click="SaveTaskButton_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                <!-- 2026-09-16 — hábitos: solo si se activaron en Personalizar. Tocar uno lo marca hoy. -->
                <StackPanel x:Name="HabitsPanel" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock Text="HÁBITOS"
                               Margin="2,0,0,6"
                               FontSize="{DynamicResource FontSizeCaption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextSecondary}" />
                    <WrapPanel x:Name="HabitsWrap" />
                    <Grid x:Name="NewHabitRow" Margin="0,4,0,0" Visibility="Collapsed">
                        <TextBox x:Name="NewHabitTextBox"
                                 Style="{StaticResource CompactTextBoxStyle}"
                                 AutomationProperties.Name="Nuevo hábito"
                                 KeyDown="NewHabitTextBox_KeyDown"
                                 TextChanged="NewHabitTextBox_TextChanged" />
                        <TextBlock x:Name="NewHabitHint"
                                   Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Text="Nombre del hábito y Enter («leer 10 páginas»)"
                                   Style="{StaticResource MutedTextStyle}" />
                    </Grid>
                </StackPanel>
                <ItemsControl x:Name="SectionsItemsControl" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <Button Tag="{Binding Key}"
                                        Style="{StaticResource SectionHeaderStyle}"
                                        IsEnabled="{Binding IsCollapsible}"
                                        AutomationProperties.Name="{Binding AccessibleName}"
                                        Click="SectionHeader_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding TitleBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="7,0,0,0"
                                                   Text="{Binding CountText}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextTertiary}" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Chevron}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextTertiary}" />
                                    </Grid>
                                </Button>

                                <ItemsControl ItemsSource="{Binding Items}"
                                              Visibility="{Binding ItemsVisibility}"
                                              Focusable="False"
                                              Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row"
                                                    Margin="0,0,0,2"
                                                    Padding="10,9"
                                                    CornerRadius="14"
                                                    Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Tag="{Binding CheckTag}"
                                                            CommandParameter="{Binding Id}"
                                                            Style="{StaticResource CheckCircleStyle}"
                                                            ToolTip="{Binding CheckName}"
                                                            AutomationProperties.Name="{Binding CheckName}"
                                                            Click="CheckButton_Click" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{Binding TitleBrush}"
                                                                   TextDecorations="{Binding TextDecorations}" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   Text="{Binding When}"
                                                                   Foreground="{Binding WhenBrush}"
                                                                   FontSize="{DynamicResource FontSizeCaption}" />
                                                    </StackPanel>
                                                    <!-- Las acciones flotan sobre el final del texto: reservarles sitio partía los títulos en dos líneas. -->
                                                    <StackPanel x:Name="Actions"
                                                                Grid.Column="1"
                                                                Grid.ColumnSpan="2"
                                                                HorizontalAlignment="Right"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource BrushSurfaceRaised}"
                                                                IsHitTestVisible="False"
                                                                Opacity="0">
                                                        <Button Content="▶"
                                                                CommandParameter="{Binding Id}"
                                                                Visibility="{Binding FocusVisibility}"
                                                                Style="{StaticResource RowActionStyle}"
                                                                ToolTip="Trabajar en esto un rato"
                                                                AutomationProperties.Name="Enfocarme en esta tarea"
                                                                Click="FocusTaskButton_Click" />
                                                        <Button Content="Mañana"
                                                                CommandParameter="{Binding Id}"
                                                                Visibility="{Binding PendingVisibility}"
                                                                Style="{StaticResource RowActionStyle}"
                                                                ToolTip="Pasarla a mañana"
                                                                AutomationProperties.Name="Dejar para mañana"
                                                                Click="PostponeTaskButton_Click" />
                                                        <Button Content="Soltar"
                                                                CommandParameter="{Binding Id}"
                                                                Visibility="{Binding PendingVisibility}"
                                                                Style="{StaticResource RowActionStyle}"
                                                                ToolTip="Dejar de verla sin borrarla"
                                                                AutomationProperties.Name="Soltar tarea"
                                                                Click="ReleaseTaskButton_Click" />
                                                        <Button Content="✎"
                                                                CommandParameter="{Binding Id}"
                                                                Style="{StaticResource RowActionStyle}"
                                                                ToolTip="Editar"
                                                                AutomationProperties.Name="Editar tarea"
                                                                Click="EditTaskButton_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
                                                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                                    <Setter TargetName="Actions" Property="IsHitTestVisible" Value="True" />
                                                </Trigger>
                                                <Trigger SourceName="Row" Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
                                                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                                    <Setter TargetName="Actions" Property="IsHitTestVisible" Value="True" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="EmptyStatePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="300"
                        Visibility="Collapsed">
                <TextBlock x:Name="EmptyStateTitle"
                           Text="Hoy está libre"
                           HorizontalAlignment="Center"
                           FontSize="{DynamicResource FontSizeBody}"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="EmptyStateText"
                           Margin="0,6,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Apunta arriba lo que tengas que hacer, como lo dirías: «llamar al dentista mañana a las 10» o «importante: estudiar para el parcial el jueves»." />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
