<UserControl x:Class="Nexo.App.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nexo.App.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  controls:ScrollEdgeFade.IsEnabled="True"
                  Focusable="False"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel>
            <TextBlock Text="Estado del equipo y de los servicios de Sakura. Las medidas en vivo están en el panel de arriba: lleva el ratón al centro del borde superior."
                       Margin="0,0,0,14"
                       TextWrapping="Wrap"
                       Style="{StaticResource MutedTextStyle}" />

            <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Capacidad del equipo" FontSize="{DynamicResource FontSizeTitle3}" FontWeight="SemiBold" />
                            <TextBlock x:Name="HardwareCapabilitySummaryText"
                                       Margin="0,3,0,0"
                                       Text="Detectando la capacidad del equipo…"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <Button x:Name="HardwareCapabilityRefreshButton"
                                Grid.Column="1"
                                Content="Actualizar detección"
                                VerticalAlignment="Top"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="HardwareCapabilityRefreshButton_Click"
                                AutomationProperties.Name="Actualizar detección de capacidad del equipo" />
                    </Grid>

                    <UniformGrid Columns="2" Margin="-4,12,-4,0">
                        <Border Margin="4" Padding="14" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="{DynamicResource RadiusMedium}">
                            <StackPanel>
                                <TextBlock Text="NIVEL" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="HardwareCapabilityTierText" Margin="0,4,0,0" Text="—" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4" Padding="14" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="{DynamicResource RadiusMedium}">
                            <StackPanel>
                                <TextBlock Text="CPU" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="HardwareCapabilityCpuText" Margin="0,4,0,0" Text="—" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4" Padding="14" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="{DynamicResource RadiusMedium}">
                            <StackPanel>
                                <TextBlock Text="NÚCLEOS" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="HardwareCapabilityCoresText" Margin="0,4,0,0" Text="—" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4" Padding="14" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="{DynamicResource RadiusMedium}">
                            <StackPanel>
                                <TextBlock Text="RAM TOTAL" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="HardwareCapabilityRamText" Margin="0,4,0,0" Text="—" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4" Padding="14" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="{DynamicResource RadiusMedium}">
                            <StackPanel>
                                <TextBlock Text="ARQUITECTURA" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="HardwareCapabilityArchitectureText" Margin="0,4,0,0" Text="—" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4" Padding="14" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="{DynamicResource RadiusMedium}">
                            <StackPanel>
                                <TextBlock Text="GPU PREFERIDA" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="HardwareCapabilityGpuText" Margin="0,4,0,0" Text="—" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4" Padding="14" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="{DynamicResource RadiusMedium}">
                            <StackPanel>
                                <TextBlock Text="MEMORIA GRÁFICA" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="HardwareCapabilityGraphicsMemoryText" Margin="0,4,0,0" Text="—" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4" Padding="14" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="{DynamicResource RadiusMedium}">
                            <StackPanel>
                                <TextBlock Text="BATERÍA" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="HardwareCapabilityBatteryText" Margin="0,4,0,0" Text="—" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!--
                        2026-09-14 — solo cuando falta algo. Las «razones» repetían, en una frase, los
                        mismos datos que la cuadrícula de arriba ya enseña, y «la información es
                        completa» aparecía siempre sin decir nada.
                    -->
                    <TextBlock x:Name="HardwareCapabilityMissingDataText"
                               Margin="4,10,4,0"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Plan adaptativo" FontSize="{DynamicResource FontSizeTitle3}" FontWeight="SemiBold" />
                            <TextBlock x:Name="AdaptiveEnginePlanSummaryText"
                                       Margin="0,3,0,0"
                                       Text="Calculando…"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="MODO" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" />
                            <TextBlock x:Name="AdaptiveEnginePlanModeText" Text="—" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="AdaptiveEnginePlanConfidenceText"
                               Margin="0,8,0,0"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />

                    <ItemsControl x:Name="AdaptiveEnginePlanItemsControl" Margin="-4,10,-4,0"
                                  AutomationProperties.Name="Plan de rendimiento por categoría">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4" Padding="14" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="{DynamicResource RadiusMedium}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding CategoryLabel}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1"
                                                       Text="Solo recomendación"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushWarning}"
                                                       Visibility="{Binding RecommendationOnlyVisibility}" />
                                        </Grid>
                                        <!--
                                            2026-09-14 — tres líneas en vez de cinco: qué se recomienda,
                                            cómo está ahora y qué falta. Antes cada línea repetía el nombre
                                            del motor y la tarjeta se leía como un informe.
                                        -->
                                        <TextBlock Margin="0,4,0,0" Text="{Binding RecommendedLine}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,2,0,0" Text="{Binding StateLine}" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding WarningText}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding WarningVisibility}"
                                                   Foreground="{DynamicResource BrushWarning}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Diseño D11 (Fase 4 — Adaptive Computer Optimization) -->
            <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Optimización del equipo" FontSize="{DynamicResource FontSizeTitle3}" FontWeight="SemiBold" />
                    <TextBlock Margin="0,3,0,0"
                               Text="Propone ajustes según tu hardware. Nada se aplica sin tu confirmación y todo se puede deshacer."
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />

                    <WrapPanel Margin="0,11,0,0">
                        <Button Margin="0,0,7,7" Content="Jugar" Tag="Jugar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OptimizationScenarioButton_Click" />
                        <Button Margin="0,0,7,7" Content="Programar" Tag="Programar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OptimizationScenarioButton_Click" />
                        <Button Margin="0,0,7,7" Content="Editar video" Tag="EdicionVideo"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OptimizationScenarioButton_Click" />
                        <Button Margin="0,0,7,7" Content="Videollamada" Tag="Videollamada"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OptimizationScenarioButton_Click" />
                        <Button Margin="0,0,7,7" Content="Batería" Tag="Bateria"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OptimizationScenarioButton_Click" />
                        <Button Margin="0,0,7,7" Content="Uso general" Tag="General"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OptimizationScenarioButton_Click" />
                    </WrapPanel>

                    <WrapPanel Margin="0,4,0,0">
                        <Button x:Name="OptimizationUndoButton"
                                Margin="0,0,7,0"
                                Content="Deshacer la última optimización"
                                IsEnabled="False"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OptimizationUndoButton_Click" />
                        <Button Content="Ver historial"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OptimizationAuditButton_Click" />
                    </WrapPanel>

                    <TextBlock x:Name="OptimizationStatusText"
                               Margin="0,9,0,0"
                               Text="Elige un uso y verás el plan antes de aplicar nada."
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Border>

            <!-- Diseño D13: Audit Log orientado al usuario -->
            <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Qué ha hecho Sakura" FontSize="{DynamicResource FontSizeTitle3}" FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="Cada acción con efecto real: qué se hizo, cuándo, con qué permiso y cómo deshacerlo."
                                       TextWrapping="Wrap"
                                       Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                VerticalAlignment="Top"
                                Content="Actualizar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="AuditRefreshButton_Click" />
                    </Grid>

                    <ItemsControl x:Name="AuditItemsControl" Margin="-4,10,-4,0"
                                  AutomationProperties.Name="Registro de acciones">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4" Padding="14" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="{DynamicResource RadiusMedium}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="9,0,0,0"
                                                       Text="{Binding When}"
                                                       Style="{StaticResource MutedTextStyle}" />
                                        </Grid>
                                        <TextBlock Margin="0,4,0,0" Text="{Binding Detail}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding PermissionLine}"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Text="{Binding ReversalLine}"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource MutedTextStyle}" />
                                        <Button Margin="0,7,0,0"
                                                HorizontalAlignment="Left"
                                                Content="Deshacer esto"
                                                Visibility="{Binding RevertVisibility}"
                                                Tag="{Binding Entry}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="AuditRevertButton_Click" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="AuditEmptyText"
                               Margin="0,9,0,0"
                               Text="Todavía no he hecho nada que valga la pena registrar."
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Mayor uso de memoria" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock x:Name="TopProcessNameText"
                                   Margin="0,5,0,0"
                                   Text="Esperando datos..."
                                   FontSize="{DynamicResource FontSizeTitle3}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock x:Name="TopProcessMemoryText"
                               Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               FontSize="{DynamicResource FontSizeBody}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <!--
                        2026-09-14 — los botones van debajo del título y no a su lado: a su lado le
                        quitaban el ancho a la descripción, que salía cortada en «Servicios locales, pri».
                    -->
                    <TextBlock Text="Sakura Runtime" FontSize="{DynamicResource FontSizeTitle3}" FontWeight="SemiBold" />
                    <TextBlock Margin="0,3,0,0"
                               Text="Los servicios locales de Sakura y cómo están ahora."
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Reiniciar voz"
                                Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="RestartVoiceButton_Click" />
                        <Button Content="Diagnóstico"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="DiagnosticsButton_Click" />
                    </WrapPanel>

                    <UniformGrid Columns="2" Margin="-4,12,-4,0">
                        <Border Margin="4" Padding="14" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="{DynamicResource RadiusMedium}">
                            <StackPanel>
                                <TextBlock Text="VOZ" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="RuntimeVoiceText" Margin="0,4,0,0" Text="Comprobando…" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4" Padding="14" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="{DynamicResource RadiusMedium}">
                            <StackPanel>
                                <TextBlock Text="IA" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="RuntimeAiText" Margin="0,4,0,0" Text="Desactivada" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4" Padding="14" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="{DynamicResource RadiusMedium}">
                            <StackPanel>
                                <TextBlock Text="VISION" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="RuntimeVisionText" Margin="0,4,0,0" Text="Activa bajo demanda" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4" Padding="14" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="{DynamicResource RadiusMedium}">
                            <StackPanel>
                                <TextBlock Text="RENDIMIENTO" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="RuntimeModeText" Margin="0,4,0,0" Text="Normal" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock x:Name="RuntimeDetailText"
                               Margin="4,9,4,0"
                               Text="Sakura está lista."
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="HealthText"
                               Text="Leyendo el equipo..."
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushSuccess}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="Alt + Shift + A abre la vista Peek sin mostrar toda la barra."
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
                <TextBlock x:Name="UpdatedAtText"
                           Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Bottom"
                           Style="{StaticResource MutedTextStyle}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
