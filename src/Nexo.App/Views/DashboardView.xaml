<UserControl x:Class="Nexo.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a11y="clr-namespace:Nexo.App.Views.Controls"
             xmlns:controls="clr-namespace:Nexo.App.Views.Controls">
    <UserControl.Resources>
        <!--
            Diseño D44 — la cápsula estrecha: título arriba, medidor y detalle debajo.

            En la referencia las cinco cápsulas son horizontales, pero a tres columnas el texto y el
            anillo se disputan el mismo sitio y gana el anillo: los títulos salían como «Discc» y
            «Mem». Apilando, el título recupera el ancho entero de la tarjeta.
        -->
        <Style x:Key="NarrowMetricCapsuleStyle" TargetType="{x:Type controls:MetricCapsule}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="GaugeSize" Value="50" />
            <Setter Property="GaugeThickness" Value="5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:MetricCapsule}">
                        <Border Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="16,15">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="16"
                                          Height="16"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Stroke="{DynamicResource BrushAccent}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="{TemplateBinding IconData}" />
                                    <TextBlock Margin="9,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               Text="{TemplateBinding Title}" />
                                </StackPanel>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="{TemplateBinding GaugeSize}"
                                          Height="{TemplateBinding GaugeSize}"
                                          VerticalAlignment="Top">
                                        <Ellipse Stroke="{DynamicResource BrushSurfaceHover}"
                                                 StrokeThickness="{TemplateBinding GaugeThickness}" />
                                        <Path x:Name="PART_Arc"
                                              Stroke="{DynamicResource BrushAccent}"
                                              StrokeThickness="{TemplateBinding GaugeThickness}"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                        <TextBlock x:Name="PART_Readout"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="{DynamicResource FontSizeFootnote}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   Text="—" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="{DynamicResource FontSizeFootnote}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Text="{TemplateBinding Subtitle}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="{DynamicResource FontSizeFootnote}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource BrushTextTertiary}"
                                                   Text="{TemplateBinding Detail}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Diseño D44 — la cápsula ancha de la fila de arriba: procesador y gráfica, que llevan el
            nombre del componente y por eso tienen más sitio.
        -->
        <Style x:Key="WideMetricCapsuleStyle" TargetType="{x:Type controls:MetricCapsule}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="GaugeSize" Value="60" />
            <Setter Property="GaugeThickness" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:MetricCapsule}">
                        <Border Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="18,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center"
                                              Stroke="{DynamicResource BrushAccent}"
                                              StrokeThickness="1.7"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Data="{TemplateBinding IconData}" />
                                        <TextBlock Margin="9,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   Text="{TemplateBinding Title}" />
                                    </StackPanel>

                                    <TextBlock Margin="0,8,0,0"
                                               FontSize="{DynamicResource FontSizeFootnote}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource BrushTextSecondary}"
                                               Text="{TemplateBinding Subtitle}" />

                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="{DynamicResource FontSizeFootnote}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource BrushTextTertiary}"
                                               Text="{TemplateBinding Detail}" />
                                </StackPanel>

                                <Grid Grid.Column="1"
                                      Width="{TemplateBinding GaugeSize}"
                                      Height="{TemplateBinding GaugeSize}"
                                      Margin="16,0,0,0"
                                      VerticalAlignment="Center">
                                    <Ellipse Stroke="{DynamicResource BrushSurfaceHover}"
                                             StrokeThickness="{TemplateBinding GaugeThickness}" />
                                    <Path x:Name="PART_Arc"
                                          Stroke="{DynamicResource BrushAccent}"
                                          StrokeThickness="{TemplateBinding GaugeThickness}"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <TextBlock x:Name="PART_Readout"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               Text="—" />
                                </Grid>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MediaControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{DynamicResource BrushSurfaceRaised}"
                                CornerRadius="23"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background"
                                        Value="{DynamicResource BrushSurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MediaPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource MediaControlButtonStyle}">
            <Setter Property="Width" Value="74" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{DynamicResource BrushAccent}"
                                CornerRadius="18"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalendarArrowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background"
                                        Value="{DynamicResource BrushSurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Diseno D53 - el chip de resumen del dia: icono, etiqueta y el dato en una linea.

            Es un boton y no una tarjeta con texto porque un resumen que no se puede accionar deja
            a medias: ver "3 pendientes" y tener que ir a buscar donde estan es peor que no verlo.
            Pulsar abre Sakura en ese modulo y recoge el cajon.
        -->
        <!--
            Diseño D65 — aquí vivía DashboardChipStyle, para los tres resúmenes pulsables que D53
            puso en esta pestaña. El rediseño del cajón (D43, D45) repartió el Panel en sesión,
            reproductor, reloj, anillos y el hueco de la imagen, y los chips se quedaron fuera sin
            que nadie lo anotara: el estilo seguía definido y ningún elemento lo usaba.

            Se retira en vez de reponerlos porque el Panel ya no tiene sitio para tres tarjetas más
            sin volver a repartirlo, y eso es una decisión de diseño, no una limpieza. Ir a
            Pendientes, Enfoque o Rutinas sigue estando a un Ctrl + K de distancia.
        -->

        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:DashboardTabStrip x:Name="DashboardTabs" Grid.Row="0" />

        <Grid Grid.Row="1" Margin="0,18,0,0">

            <!-- ============================ PANEL ============================ -->
            <!--
                Diseño D76 — la retícula del panel, como la referencia.

                Antes eran dos filas de celdas iguales: arriba sesión y media a mitades, abajo
                reloj, calendario y anillos. Todo del mismo tamaño se lee como una LISTA de fichas,
                y la referencia no es una lista: es un tablero donde el tamaño de cada celda dice
                cuánto importa lo que hay dentro.

                El cambio de fondo es que **media deja de ser media fila y pasa a ser una columna
                entera a la derecha**, alta, con la carátula grande arriba y los controles debajo.
                Eso libera la fila de arriba para la tarjeta de sesión —que ahora ocupa todo el
                ancho útil— y deja el reloj, el calendario y los anillos abajo, con sus anchos
                distintos. El hueco de la imagen va al pie de esa columna, que es donde la
                referencia pone el gato.

                Las piezas son las mismas. Lo único que cambia es dónde va cada una y cuánto ocupa.
            -->
            <Grid x:Name="PanelPane">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="PanelPaneTranslate" />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- ============================ zona izquierda ============================ -->
                <Grid Grid.Column="0" Margin="-6,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--
                        Fila de arriba: «Ahora» a la izquierda —donde la referencia pone el clima— y
                        la sesión a su derecha. «Ahora» se lleva el trozo ancho porque lo que enseña
                        es un título de ventana, que es largo; la sesión dice un nombre y un tiempo
                        de encendido y no necesita más.
                    -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--
                            Diseño D80 — «Ahora»: en qué estás en este momento.

                            Lo que enseña lo decide NowGlancePolicy, en Nexo.Core, y no esta vista:
                            la regla de que una ventana marcada como sensible no se nombra es una
                            decisión de producto con pruebas detrás, no un detalle de presentación.
                        -->
                        <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="46"
                                        Height="46"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource BrushCoolBlueSoft}"
                                        BorderBrush="{DynamicResource BrushCoolBlue}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                    <Path Width="20"
                                          Height="20"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource BrushCoolBlue}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="{StaticResource IconSidebarPanel}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="PanelNowHeadlineText"
                                               Text="Sakura"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               AutomationProperties.Name="Aplicación en primer plano" />
                                    <TextBlock x:Name="PanelNowDetailText"
                                               Margin="0,4,0,0"
                                               Text="No hay otra ventana delante"
                                               FontSize="{DynamicResource FontSizeFootnote}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource BrushTextSecondary}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="46"
                                        Height="46"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource BrushAccentSoft}"
                                        BorderBrush="{DynamicResource BrushAccentBorder}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                    <Path Width="20"
                                          Height="20"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource BrushAccent}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="{StaticResource IconSakuraHome}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="PanelSessionTitleText"
                                               Text="Sakura"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="PanelUptimeText"
                                               Margin="0,4,0,0"
                                               Text="—"
                                               FontSize="{DynamicResource FontSizeFootnote}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource BrushTextSecondary}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Reloj estrecho · calendario ancho · anillos estrechos. -->
                    <Grid Grid.Row="1" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" MinWidth="116" Style="{StaticResource DashboardCardStyle}" Padding="20,18">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="PanelClockHourText"
                                           Text="--"
                                           FontSize="{DynamicResource FontSizeDisplay}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource BrushTextPrimary}" />
                                <a11y:DecorativeText Text="•••"
                                           Margin="0,2"
                                           HorizontalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeFootnote}"
                                           Foreground="{DynamicResource BrushAccent}" />
                                <TextBlock x:Name="PanelClockMinuteText"
                                           Text="--"
                                           FontSize="{DynamicResource FontSizeDisplay}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock x:Name="PanelClockMeridiemText"
                                           Text=""
                                           Margin="0,6,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeFootnote}"
                                           Foreground="{DynamicResource BrushTextSecondary}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Style="{StaticResource CalendarArrowButtonStyle}"
                                            Click="CalendarPreviousButton_Click"
                                            ToolTip="Mes anterior"
                                            AutomationProperties.Name="Mes anterior">
                                        <Path Width="7"
                                              Height="11"
                                              Data="M6,0 L0,5 L6,10"
                                              Stretch="Fill"
                                              Stroke="{DynamicResource BrushTextSecondary}"
                                              StrokeThickness="1.7"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Button>
                                    <TextBlock x:Name="CalendarMonthText"
                                               Grid.Column="1"
                                               Text="—"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               FontWeight="SemiBold" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource CalendarArrowButtonStyle}"
                                            Click="CalendarNextButton_Click"
                                            ToolTip="Mes siguiente"
                                            AutomationProperties.Name="Mes siguiente">
                                        <Path Width="7"
                                              Height="11"
                                              Data="M0,0 L6,5 L0,10"
                                              Stretch="Fill"
                                              Stroke="{DynamicResource BrushTextSecondary}"
                                              StrokeThickness="1.7"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Button>
                                </Grid>

                                <ItemsControl AutomationProperties.Name="Días de la semana" x:Name="CalendarWeekdayItems" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="7" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       HorizontalAlignment="Center"
                                                       FontSize="{DynamicResource FontSizeFootnote}"
                                                       Foreground="{DynamicResource BrushTextTertiary}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl AutomationProperties.Name="Calendario del mes" x:Name="CalendarDayItems" Margin="0,7,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="6" Columns="7" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="2"
                                                    Height="30"
                                                    CornerRadius="11"
                                                    Background="{Binding Background}">
                                                <TextBlock Text="{Binding Day}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="{DynamicResource FontSizeFootnote}"
                                                           FontWeight="{Binding Weight}"
                                                           Foreground="{Binding Foreground}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}" Padding="14,16">
                            <StackPanel VerticalAlignment="Center">
                                <controls:IconRing x:Name="PanelCpuRing"
                                                   IconData="{StaticResource IconMetricCpu}"
                                                   ToolTip="Uso del procesador"
                                                   AutomationProperties.Name="Uso del procesador" />
                                <controls:IconRing x:Name="PanelMemoryRing"
                                                   Margin="0,14,0,0"
                                                   IconData="{StaticResource IconMetricMemory}"
                                                   ToolTip="Uso de la memoria"
                                                   AutomationProperties.Name="Uso de la memoria" />
                                <controls:IconRing x:Name="PanelDiskRing"
                                                   Margin="0,14,0,0"
                                                   IconData="{StaticResource IconMetricDisk}"
                                                   ToolTip="Uso del disco del sistema"
                                                   AutomationProperties.Name="Uso del disco del sistema" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ========================= columna de la derecha ========================= -->
                <Grid Grid.Column="1" Width="196" Margin="0,0,-6,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--
                        Media, alta. La carátula pasa de 46 a 120: a 46 la flor de PetalGeometry se
                        devuelve como círculo a propósito —una ondulación de dos píxeles y medio no
                        se lee como borde, solo ensucia el canto— y a 120 sí ondula, que es lo que
                        hace que la portada se reconozca como la marca y no como un círculo.
                    -->
                    <Border Grid.Row="0"
                            VerticalAlignment="Stretch"
                            Style="{StaticResource DashboardCardStyle}"
                            Padding="16,18">
                        <StackPanel VerticalAlignment="Center">
                            <!--
                                Diseño D82 — la carátula del panel gira y tiene rayos, como la de
                                la pestaña Media.

                                Las dos piezas ya existían y solo vivían allí: `CoverVisualizer`
                                dibuja las bandas del espectro en un único trazado por fotograma, y
                                el giro es el mismo que ya se arranca y se para con la reproducción.
                                Aquí se reutilizan a su escala: el anillo mide 160 y la carátula
                                sigue en 120, así que los rayos caben entre la flor y el borde de la
                                tarjeta sin tocar ninguno de los dos.
                            -->
                            <Grid Width="160" Height="160" HorizontalAlignment="Center">
                                <controls:CoverVisualizer x:Name="PanelCoverRing"
                                                          BarBrush="{DynamicResource BrushAccent}"
                                                          InnerRadius="64"
                                                          MaximumBarLength="15"
                                                          BarThickness="2.6"
                                                          Opacity="0.85"
                                                          IsHitTestVisible="False" />

                                <Grid Width="120" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="PanelMediaBackdrop" Fill="{DynamicResource BrushSurfaceRaised}" />
                                <Path x:Name="PanelMediaPlaceholderIcon"
                                      Width="42"
                                      Height="42"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource BrushTextTertiary}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="{StaticResource IconMediaNote}" />
                                <Path x:Name="PanelMediaCoverShape" Visibility="Collapsed">
                                    <Path.Fill>
                                        <ImageBrush x:Name="PanelMediaCoverBrush" Stretch="UniformToFill" />
                                    </Path.Fill>
                                </Path>
                                </Grid>
                            </Grid>

                            <TextBlock x:Name="PanelMediaTitleText"
                                       Margin="0,16,0,0"
                                       Text="Nada sonando"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="PanelMediaArtistText"
                                       Margin="0,4,0,0"
                                       Text="Sin reproducción"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       FontSize="{DynamicResource FontSizeFootnote}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource BrushTextSecondary}" />

                            <!--
                                Diseño D61 — los tres controles, como en la referencia. Con solo
                                reproducir/pausar había que abrir la pestaña Media para cambiar de
                                canción, que es el gesto más frecuente de los tres.
                            -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,16,0,0"
                                        HorizontalAlignment="Center">
                                <Button x:Name="PanelMediaPreviousButton"
                                        Width="30"
                                        Height="30"
                                        Margin="0,0,6,0"
                                        IsEnabled="False"
                                        Style="{StaticResource MediaControlButtonStyle}"
                                        Click="MediaPreviousButton_Click"
                                        ToolTip="Anterior"
                                        AutomationProperties.Name="Pista anterior">
                                    <Path Width="12"
                                          Height="12"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource BrushTextPrimary}"
                                          Data="{StaticResource IconMediaPrevious}" />
                                </Button>

                                <Button x:Name="PanelMediaPlayButton"
                                        Width="38"
                                        Height="38"
                                        Margin="0"
                                        IsEnabled="False"
                                        Style="{StaticResource MediaControlButtonStyle}"
                                        Click="MediaPlayPauseButton_Click"
                                        ToolTip="Reproducir o pausar"
                                        AutomationProperties.Name="Reproducir o pausar">
                                    <Path x:Name="PanelMediaPlayIcon"
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource BrushTextPrimary}"
                                          Data="{StaticResource IconMediaPlay}" />
                                </Button>

                                <Button x:Name="PanelMediaNextButton"
                                        Width="30"
                                        Height="30"
                                        Margin="6,0,0,0"
                                        IsEnabled="False"
                                        Style="{StaticResource MediaControlButtonStyle}"
                                        Click="MediaNextButton_Click"
                                        ToolTip="Siguiente"
                                        AutomationProperties.Name="Pista siguiente">
                                    <Path Width="12"
                                          Height="12"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource BrushTextPrimary}"
                                          Data="{StaticResource IconMediaNext}" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--
                        Diseño D58 — un hueco que Sakura no usa para nada.

                        Va al pie de la columna de la canción, que es donde la referencia pone el
                        gato. No lleva título ni borde propio cuando hay imagen: lo que se pone aquí
                        no es un dato del sistema y enmarcarlo como los demás lo convertiría en uno.

                        Vacío se enseña como una invitación discreta y no como un error: nadie tiene
                        por qué poner nada, y un recuadro punteado gritando «falta algo» en un panel
                        que se abre veinte veces al día cansa el primer día.
                    -->
                    <Button x:Name="PanelImageButton"
                            Grid.Row="1"
                            Margin="6,0,6,6"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="PanelImageButton_Click"
                            ToolTip="Elige una imagen para este hueco"
                            AutomationProperties.Name="Tu imagen o un GIF: elegir la imagen del panel">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <!--
                                El marco invisible: la imagen llena el hueco y se recorta con las mismas
                                esquinas que la tarjeta de música (DashboardCardStyle, 20). Con Uniform
                                quedaba un rectángulo de esquinas en pico flotando en medio del hueco.
                            -->
                            <a11y:RoundedClipBorder x:Name="PanelUserImageFrame"
                                                    Height="132"
                                                    CornerRadius="20"
                                                    Visibility="Collapsed">
                                <Image x:Name="PanelUserImage"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </a11y:RoundedClipBorder>
                            <Border x:Name="PanelImageEmptyHint"
                                    MinHeight="104"
                                    CornerRadius="20"
                                    Background="{DynamicResource BrushSurface}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <a11y:DecorativeText Text="+"
                                               HorizontalAlignment="Center"
                                               FontSize="19"
                                               Foreground="{DynamicResource BrushTextTertiary}" />
                                    <TextBlock Text="Tu imagen o un GIF"
                                               Margin="0,3,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource BrushTextTertiary}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Button>
                </Grid>
            </Grid>

            <!-- ============================ MEDIA ============================ -->
            <Grid x:Name="MediaPane" Visibility="Collapsed" MinHeight="248">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="MediaPaneTranslate" />
                </Grid.RenderTransform>

                <StackPanel x:Name="MediaEmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="86"
                            Height="86"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource BrushAccentSoft}"
                            BorderBrush="{DynamicResource BrushAccentBorder}"
                            BorderThickness="1"
                            CornerRadius="30">
                        <Path Width="38"
                              Height="38"
                              Stretch="Uniform"
                              Stroke="{DynamicResource BrushAccent}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="{StaticResource IconMediaNote}" />
                    </Border>
                    <TextBlock Text="No hay nada sonando"
                               Margin="0,20,0,0"
                               HorizontalAlignment="Center"
                               FontSize="{DynamicResource FontSizeTitle2}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Pon música o un vídeo y aparecerá aquí."
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               FontSize="{DynamicResource FontSizeCallout}"
                               Foreground="{DynamicResource BrushTextSecondary}" />
                </StackPanel>

                <Grid x:Name="MediaNowPlayingPanel" Visibility="Collapsed" VerticalAlignment="Center" Margin="6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--
                        Diseño D46 — la carátula es redonda y el anillo de rayos la rodea, como en
                        la referencia. El anillo va DETRÁS en el orden del Grid para que los rayos
                        que arrancan bajo el borde de la carátula queden tapados por ella: así los
                        rayos parecen salir de debajo del disco y no apoyarse encima.
                    -->
                    <Grid Grid.Column="0" Width="264" Height="264" VerticalAlignment="Center">
                        <!--
                            Diseño D46 — los rayos arrancan DENTRO del disco (radio 90 contra los 94
                            de la portada) para que salgan de debajo de ella y no apoyados en su
                            borde. El anillo va antes en el Grid, así que la portada lo tapa en esos
                            cuatro píxeles y el arranque de cada rayo no se ve.
                        -->
                        <controls:CoverVisualizer x:Name="CoverRing"
                                                  InnerRadius="92"
                                                  MaximumBarLength="34"
                                                  BarThickness="4.5"
                                                  BarBrush="{DynamicResource BrushAccent}" />

                        <!--
                            La portada es una elipse con la imagen como relleno, y no un Border
                            redondeado con la imagen dentro.

                            Un Border con CornerRadius y ClipToBounds NO recorta en redondo:
                            ClipToBounds recorta al rectángulo de la caja y el radio se lo pierde.
                            La imagen salía cuadrada y sus esquinas tapaban el anillo entero menos
                            arriba y abajo, que era justo lo que se veía. Es el mismo defecto que ya
                            apareció en el mando de volumen (D39); allí se resolvió con una
                            geometría de recorte, y aquí, siendo un círculo, sale más limpio
                            pintando la imagen como relleno de la propia elipse.
                        -->
                        <Path x:Name="MediaCoverBackdrop"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="{DynamicResource BrushSurfaceRaised}">
                            <Path.Effect>
                                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.4" Color="Black" />
                            </Path.Effect>
                        </Path>

                        <Path Width="56"
                              Height="56"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stretch="Uniform"
                              Stroke="{DynamicResource BrushTextTertiary}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="{StaticResource IconMediaNote}" />

                        <!--
                            Diseño D55 — la imagen va derecha y lo que gira es el recorte.

                            Antes era un Path relleno con la carátula, y girar el Path giraba la foto
                            con él: el disco entero daba vueltas, cuando lo que tiene que girar es la
                            silueta de pétalos. Ahora la imagen es un rectángulo quieto y la flor es
                            su máscara; la máscara gira, la foto no.
                        -->
                        <Rectangle x:Name="MediaCoverShape"
                                   Width="188"
                                   Height="188"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed">
                            <Rectangle.Fill>
                                <ImageBrush x:Name="MediaCoverBrush" Stretch="UniformToFill" />
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="28,0,4,0" VerticalAlignment="Center">
                        <TextBlock x:Name="MediaTitleText"
                                   Text="—"
                                   FontSize="{DynamicResource FontSizeTitle1}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MediaArtistText"
                                   Margin="0,8,0,0"
                                   Text="—"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MediaAlbumText"
                                   Margin="0,5,0,0"
                                   Text=""
                                   FontSize="{DynamicResource FontSizeCallout}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource BrushTextTertiary}" />

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="MediaPositionText"
                                       Text="0:00"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSizeFootnote}"
                                       Foreground="{DynamicResource BrushTextSecondary}" />

                            <controls:WobblyProgressBar x:Name="MediaProgressBar"
                                                        Grid.Column="1"
                                                        Margin="16,0"
                                                        Height="18"
                                                        PlayedBrush="{DynamicResource BrushAccent}"
                                                        RemainingBrush="{DynamicResource BrushSurfaceHover}" />

                            <TextBlock x:Name="MediaDurationText"
                                       Grid.Column="2"
                                       Text="0:00"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSizeFootnote}"
                                       Foreground="{DynamicResource BrushTextSecondary}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="-6,20,0,0">
                            <Button x:Name="MediaPreviousButton"
                                    Style="{StaticResource MediaControlButtonStyle}"
                                    Click="MediaPreviousButton_Click"
                                    ToolTip="Anterior"
                                    AutomationProperties.Name="Pista anterior">
                                <Path Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      Fill="{DynamicResource BrushTextPrimary}"
                                      Data="{StaticResource IconMediaPrevious}" />
                            </Button>
                            <Button x:Name="MediaPlayPauseButton"
                                    Style="{StaticResource MediaPlayButtonStyle}"
                                    Click="MediaPlayPauseButton_Click"
                                    ToolTip="Reproducir o pausar"
                                    AutomationProperties.Name="Reproducir o pausar">
                                <Path x:Name="MediaPlayPauseIcon"
                                      Width="18"
                                      Height="18"
                                      Stretch="Uniform"
                                      Fill="White"
                                      Data="{StaticResource IconMediaPlay}" />
                            </Button>
                            <Button x:Name="MediaNextButton"
                                    Style="{StaticResource MediaControlButtonStyle}"
                                    Click="MediaNextButton_Click"
                                    ToolTip="Siguiente"
                                    AutomationProperties.Name="Pista siguiente">
                                <Path Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      Fill="{DynamicResource BrushTextPrimary}"
                                      Data="{StaticResource IconMediaNext}" />
                            </Button>

                            <Border x:Name="MediaSourceChip"
                                    Margin="18,0,0,0"
                                    Padding="15,9"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource BrushSurfaceRaised}"
                                    CornerRadius="16">
                                <TextBlock x:Name="MediaSourceText"
                                           Text="—"
                                           FontSize="{DynamicResource FontSizeFootnote}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextSecondary}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ========================= RENDIMIENTO ========================= -->
            <Grid x:Name="PerformancePane" Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="PerformancePaneTranslate" />
                </Grid.RenderTransform>
                <StackPanel Margin="-6,0">
                    <UniformGrid Columns="2">
                        <controls:MetricCapsule x:Name="CpuCapsule" Title="CPU"
                                                Style="{StaticResource WideMetricCapsuleStyle}"
                                                IconData="{StaticResource IconMetricCpu}" />
                        <controls:MetricCapsule x:Name="GpuCapsule" Title="GPU"
                                                Style="{StaticResource WideMetricCapsuleStyle}"
                                                IconData="{StaticResource IconMetricGpu}" />
                    </UniformGrid>

                    <UniformGrid Columns="3">
                        <controls:MetricCapsule x:Name="DiskCapsule" Title="Disco"
                                                Style="{StaticResource NarrowMetricCapsuleStyle}"
                                                IconData="{StaticResource IconMetricDisk}" />
                        <controls:MetricCapsule x:Name="NetworkCapsule" Title="Red"
                                                Style="{StaticResource NarrowMetricCapsuleStyle}"
                                                IconData="{StaticResource IconMetricNetwork}" />
                        <controls:MetricCapsule x:Name="MemoryCapsule" Title="Memoria"
                                                Style="{StaticResource NarrowMetricCapsuleStyle}"
                                                IconData="{StaticResource IconMetricMemory}" />
                    </UniformGrid>
                </StackPanel>
            </Grid>
            <!-- ============================ CHEATS ============================ -->
            <!--
                2026-09-14 — «Cheats», antes «Voz» (Adler). Los atajos de Sakura y unos cuantos de
                Windows en tarjetas con teclas dibujadas, las frases que se le pueden decir y, arriba,
                el estado de la escucha en una línea: sigue contestando a «¿por qué no me oye?», que
                era para lo que existía la pestaña (D81), sin ocupar media pantalla.

                Todo sale de CheatSheet y VoiceCommandExamples, que tienen pruebas: una chuleta con
                una combinación que no hace nada no se vuelve a mirar.
            -->
            <Grid x:Name="CheatsPane" Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="CheatsPaneTranslate" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- La voz en una línea. La marca de atención sigue siendo un punto, no solo un color. -->
                <ItemsControl x:Name="VoiceRowItems"
                              Margin="-2,0,-2,0"
                              AutomationProperties.Name="Estado de la voz">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2,0,8,6"
                                    Padding="12,6"
                                    CornerRadius="12"
                                    Background="{DynamicResource BrushSurfaceRaised}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7"
                                             Height="7"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Fill="{DynamicResource BrushWarning}"
                                             Visibility="{Binding MarkVisibility}" />
                                    <TextBlock Text="{Binding Label}"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeFootnote}"
                                               Foreground="{DynamicResource BrushTextTertiary}" />
                                    <TextBlock Text="{Binding Value}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeFootnote}"
                                               Foreground="{Binding Foreground}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl x:Name="CheatGroupItems"
                              Grid.Row="1"
                              Margin="-6,4,-6,0"
                              AutomationProperties.Name="Atajos de teclado">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DashboardCardStyle}"
                                    Margin="6,0"
                                    Padding="16,12,16,8">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform />
                                        <TranslateTransform />
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <!-- Las descripciones empiezan todas a la misma altura dentro de cada tarjeta. -->
                                <StackPanel Grid.IsSharedSizeScope="True">
                                    <TextBlock Text="{Binding Title}"
                                               Margin="0,0,0,8"
                                               FontSize="{DynamicResource FontSizeFootnote}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushAccent}" />
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CheatKeys" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ItemsControl ItemsSource="{Binding KeyParts}" Focusable="False" VerticalAlignment="Center">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <!-- Una tecla: cara clara y un canto más oscuro abajo, como una tecla de verdad. -->
                                                                <Border Margin="0,0,4,0"
                                                                        MinWidth="24"
                                                                        Padding="7,2,7,3"
                                                                        CornerRadius="6"
                                                                        Background="{DynamicResource BrushSurfaceRaised}"
                                                                        BorderBrush="{DynamicResource BrushBorder}"
                                                                        BorderThickness="1,1,1,2">
                                                                    <TextBlock Text="{Binding}"
                                                                               HorizontalAlignment="Center"
                                                                               FontSize="11.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource BrushTextPrimary}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Action}"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap"
                                                               FontSize="{DynamicResource FontSizeFootnote}"
                                                               Foreground="{DynamicResource BrushTextSecondary}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="VoiceExamplesCard"
                        Grid.Row="2"
                        Style="{StaticResource DashboardCardStyle}"
                        Margin="-6,12,-6,0"
                        Padding="18,12,18,6">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform />
                            <TranslateTransform />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock Text="Dile a Sakura, después de la frase de activación o Alt + V"
                                   FontSize="{DynamicResource FontSizeFootnote}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushAccent}" />
                        <ItemsControl x:Name="VoiceExampleItems"
                                      Margin="0,8,0,0"
                                      AutomationProperties.Name="Ejemplos de órdenes por voz">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="84" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}"
                                                   Margin="0,5,0,0"
                                                   FontSize="{DynamicResource FontSizeFootnote}"
                                                   Foreground="{DynamicResource BrushTextTertiary}" />
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Phrases}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,6,6"
                                                            Padding="10,4"
                                                            CornerRadius="10"
                                                            Background="{DynamicResource BrushAccentSoft}">
                                                        <TextBlock Text="{Binding StringFormat=«{0}»}"
                                                                   FontSize="{DynamicResource FontSizeFootnote}"
                                                                   Foreground="{DynamicResource BrushTextPrimary}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
