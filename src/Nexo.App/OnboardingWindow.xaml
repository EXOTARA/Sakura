<Window x:Class="Nexo.App.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Nexo.App.Views.Controls"
        Title="Configurar Sakura"
        Width="680"
        Height="610"
        MinWidth="620"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBackground}"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ContentControl Width="24"
                                    Height="24"
                                    Margin="0,0,9,0"
                                    Foreground="{DynamicResource BrushAccent}"
                                    Style="{StaticResource SakuraFlowerMarkStyle}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SAKURA"
                                   Foreground="{DynamicResource BrushAccent}"
                                   FontSize="{DynamicResource FontSizeCallout}"
                                   FontWeight="Bold" />
                        <TextBlock Text="Tu Windows, en flor."
                                   Margin="0,1,0,0"
                                   Foreground="{DynamicResource BrushTextTertiary}"
                                   FontSize="{DynamicResource FontSizeCaption}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="StepTitleText"
                           Margin="0,10,0,0"
                           Text="Bienvenido a Sakura"
                           Style="{StaticResource SectionTitleStyle}" />
            </StackPanel>
            <!--
                2026-09-14 — el avance en cuatro píldoras en vez de «1 de 4»: la del paso actual se
                alarga y toma el acento, las ya hechas quedan tenues. Se lee de un vistazo cuánto falta.
            -->
            <StackPanel x:Name="StepDots"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,8"
                        Orientation="Horizontal"
                        AutomationProperties.Name="Paso 1 de 4" />
        </Grid>

        <!--
            2026-09-14 — el contenido de cada paso se desplaza si no cabe. En el paso de la IA, con Ollama
            conectado, la recomendación de modelo quedaba cortada por el borde de la tarjeta, y agrandar la
            ventana no es opción: en un portátil pequeño con escalado ya roza el alto de la pantalla.
        -->
        <Border Grid.Row="1" Margin="0,20" Style="{StaticResource CardStyle}" Padding="22,22,10,22">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False"
                          controls:ScrollEdgeFade.IsEnabled="True">
            <Grid x:Name="StepHost" Margin="0,0,12,0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="StepHostTranslate" />
                </Grid.RenderTransform>
                <StackPanel x:Name="WelcomePanel">
                    <TextBlock Text="Tu asistente local para Windows"
                               FontSize="{DynamicResource FontSizeTitle1}"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,12,0,0"
                               Text="Sakura puede responder con IA local, escuchar órdenes, analizar una ventana, administrar tareas, temporizadores y rutinas sin obligarte a usar servicios de pago."
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource FontSizeBody}" />
                    <Border Margin="0,22,0,0" Style="{StaticResource SubtleCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Durante esta configuración" FontWeight="SemiBold" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="• Elegirás el micrófono.&#x0a;• Conectarás la IA local, si quieres usarla.&#x0a;• Revisarás la privacidad y cómo arranca Sakura."
                                       TextWrapping="Wrap"
                                       Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="0,20,0,0"
                               Text="Todo se puede cambiar después en Personalizar."
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>

                <StackPanel x:Name="VoicePanel" Visibility="Collapsed">
                    <TextBlock Margin="0,0,0,18"
                               Text="Elige el micrófono con el que le hablarás a Sakura. El audio se procesa en tu equipo, y el modelo de voz (unos 140 MB) se descarga la primera vez que la uses."
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="Micrófono" FontWeight="SemiBold" />
                    <!-- ItemTemplate explícita: ver la nota del selector de proveedor en SettingsView.xaml. -->
                    <ComboBox x:Name="MicrophoneComboBox"
                              AutomationProperties.Name="Micrófono"
                              Margin="0,8,0,0"
                              MinHeight="38"
                              SelectedValuePath="DeviceNumber">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock x:Name="MicrophoneStatusText"
                               Margin="0,7,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />
                    <CheckBox x:Name="WakeWordCheckBox"
                              Margin="0,22,0,0"
                              Content="Activar la frase “Oye Sakura” (experimental)" />
                    <TextBlock Margin="24,7,0,0"
                               Text="Si la dejas apagada, puedes hablarle con Alt + V o con el botón del micrófono."
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>

                <StackPanel x:Name="AiPanel" Visibility="Collapsed">
                    <TextBlock Margin="0,0,0,16"
                               Text="Opcional. Sakura por sí sola ocupa unos 250 MB; la IA local (Ollama y el modelo) ocupa unos 5 GB y descarga cerca de 4,8 GB, así que puede tardar según tu conexión. Todo se queda en tu equipo. Si prefieres no descargarla, puedes usar un proveedor en la nube con tu clave (Personalizar → IA) o seguir sin IA: Sakura sigue entendiendo órdenes, tareas y dictado."
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />

                    <Border Style="{StaticResource SubtleCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="AiRuntimeTitleText"
                                       Text="Comprobando la IA local…"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="AiStatusText"
                                       Margin="0,7,0,0"
                                       Text="Revisando si Ollama está disponible."
                                       TextWrapping="Wrap"
                                       Style="{StaticResource MutedTextStyle}" />
                            <ProgressBar x:Name="AiProgressBar"
                                         Margin="0,14,0,0"
                                         Height="7"
                                         Minimum="0"
                                         Maximum="100"
                                         IsIndeterminate="True"
                                         Visibility="Collapsed" />
                            <TextBlock x:Name="AiProgressText"
                                       Margin="0,7,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       Style="{StaticResource MutedTextStyle}" />
                            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                <Button x:Name="InstallAiButton"
                                        Content="Instalar IA local"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Visibility="Collapsed"
                                        Click="InstallAiButton_Click" />
                                <Button x:Name="CancelAiInstallButton"
                                        Margin="10,0,0,0"
                                        Content="Cancelar"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Visibility="Collapsed"
                                        Click="CancelAiInstallButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,20,0,8"
                               Text="Modelo"
                               FontWeight="SemiBold" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="AiModelComboBox"
                                  AutomationProperties.Name="Modelo de inteligencia artificial"
                                  MinHeight="38"
                                  IsEditable="True"
                                  IsEnabled="False" />
                        <Button x:Name="RefreshModelsButton"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Content="Actualizar"
                                IsEnabled="False"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="RefreshModelsButton_Click" />
                    </Grid>
                    <Button x:Name="ManageModelsButton"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Left"
                            Content="Opciones avanzadas"
                            IsEnabled="False"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ManageModelsButton_Click" />
                    <Border Margin="0,20,0,0" Style="{StaticResource SubtleCardStyle}">
                        <TextBlock Text="Sakura recomienda qwen3.5:4b: funciona con texto e imágenes y mantiene un tamaño razonable para un equipo medio."
                                   TextWrapping="Wrap"
                                   Style="{StaticResource MutedTextStyle}" />
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PrivacyPanel" Visibility="Collapsed">
                    <TextBlock Margin="0,0,0,18"
                               Text="Elige qué funciones quedan activas. Las capturas siempre requieren una acción explícita y una vista previa."
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />
                    <CheckBox x:Name="VisionCheckBox"
                              Margin="0,0,0,12"
                              Content="Dejar que Lens mire la pantalla cuando se lo pidas" />
                    <CheckBox x:Name="StartWithWindowsCheckBox"
                              Margin="0,0,0,12"
                              Content="Iniciar Sakura con Windows" />
                    <CheckBox x:Name="MinimizeToTrayCheckBox"
                              Margin="0,0,0,12"
                              Content="Ocultar en la bandeja al cerrar" />
                    <CheckBox x:Name="WindowsNotificationsCheckBox"
                              Margin="0,0,0,12"
                              Content="Mostrar notificaciones" />
                    <CheckBox x:Name="NotificationSoundsCheckBox"
                              Content="Reproducir sonidos de recordatorios y enfoque" />
                    <TextBlock x:Name="FinishStatusText"
                               Margin="0,18,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SkipButton"
                    Content="Omitir"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="SkipButton_Click" />
            <Button x:Name="BackButton"
                    Grid.Column="2"
                    Margin="0,0,10,0"
                    Content="Atrás"
                    IsEnabled="False"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="BackButton_Click" />
            <Button x:Name="NextButton"
                    Grid.Column="3"
                    Content="Siguiente"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="NextButton_Click" />
        </Grid>
    </Grid>
</Window>
