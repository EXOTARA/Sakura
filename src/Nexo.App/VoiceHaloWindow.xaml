<Window x:Class="Nexo.App.VoiceHaloWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sakura escuchando"
        Width="230"
        Height="230"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual"
        SourceInitialized="Window_SourceInitialized"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.Name="Sakura está escuchando">

    <!--
        Diseño D72 — el halo de voz.

        Es una de las dos ventanas que conservan AllowsTransparency a propósito, junto al resaltado
        de Lens: entre los anillos tiene que haber agujero, no fondo. Aquí la transparencia por
        píxel es la función, no un adorno, así que el argumento de D62 —que obliga a componer por
        software— no aplica: lo que se dibuja son unos pocos trazos sobre una superficie pequeña.

        No acepta foco ni clics. Aparece encima de lo que estés haciendo y no interrumpe nada; si
        se quedara con un clic sería exactamente el fallo que D56 costó encontrar.
    -->
    <Grid x:Name="HaloRoot" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="HaloRise" Y="0" />
        </Grid.RenderTransform>
    </Grid>
</Window>
