    <!--
        Diseño D47 — la casilla y el botón de opción, escritos de cero.

        Hasta ahora no tenían plantilla: WPF dibujaba la suya, que es el cuadrito gris de la época
        de Windows 8 y desentona con todo lo demás. El estilo anterior solo cambiaba el color del
        texto y el cursor, así que el control seguía siendo ajeno a Sakura.

        Las dos formas siguen la regla de siempre: cuadrado redondeado para lo que se puede marcar
        en cualquier combinación, círculo para elegir una de varias. Es la única señal que
        distingue «marca los que quieras» de «solo uno», y por eso no se unifican aunque quedaría
        más limpio.

        El área pulsable abarca la fila entera y no solo el cuadrito de veintidós píxeles: apuntar
        a un objetivo así de pequeño es justo lo que sobra cuando hay quince opciones que revisar.
    -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Padding" Value="12,0,0,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Row"
                            Background="Transparent"
                            CornerRadius="{DynamicResource RadiusSmall}"
                            Padding="6,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Box"
                                    Width="22"
                                    Height="22"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource BrushInput}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1.5"
                                    CornerRadius="7"
                                    SnapsToDevicePixels="True">
                                <!--
                                    La marca entra con un golpe de escala de ciento veinte
                                    milisegundos: lo justo para confirmar que el clic surtió efecto
                                    sin obligar a esperar a la animación.
                                -->
                                <Path x:Name="Check"
                                      Width="12"
                                      Height="9"
                                      Stretch="Uniform"
                                      Data="M0,4.6 L4,8.6 L11,0.6"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Opacity="0"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="CheckScale" ScaleX="0.4" ScaleY="0.4" />
                                    </Path.RenderTransform>
                                </Path>
                            </Border>

                            <ContentPresenter Grid.Column="1"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrushAccent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                            <Setter TargetName="Check" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CheckScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="CheckScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CheckScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.4"
                                                         Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="CheckScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.4"
                                                         Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Tercer estado: ni marcado ni sin marcar. Una raya, nunca una palomita. -->
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrushAccentSoft}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushAccentBorder}" />
                            <Setter TargetName="Check" Property="Data" Value="M0,4.6 L11,4.6" />
                            <Setter TargetName="Check" Property="Stroke" Value="{DynamicResource BrushAccent}" />
                            <Setter TargetName="Check" Property="Opacity" Value="1" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushFocusRing}" />
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Padding" Value="12,0,0,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Row"
                            Background="Transparent"
                            CornerRadius="{DynamicResource RadiusSmall}"
                            Padding="6,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="22" Height="22" VerticalAlignment="Top">
                                <Ellipse x:Name="Ring"
                                         Fill="{DynamicResource BrushInput}"
                                         Stroke="{DynamicResource BrushBorder}"
                                         StrokeThickness="1.5" />
                                <Ellipse x:Name="Dot"
                                         Width="10"
                                         Height="10"
                                         Fill="White"
                                         Opacity="0"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="DotScale" ScaleX="0.4" ScaleY="0.4" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>

                            <ContentPresenter Grid.Column="1"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource BrushAccent}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource BrushAccent}" />
                            <Setter TargetName="Dot" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DotScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="DotScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource BrushFocusRing}" />
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ================================================================================
        Diseño D2 — componentes compartidos de workspace.

        Patrones que se repetían copiados entre las nueve vistas (tarjetas pulsables,
        métricas, chips de estado, estados vacíos y de error, barras de herramientas,
        separadores). Se centralizan aquí para que una vista nueva no tenga que reinventar
        —ni desviarse de— el lenguaje visual del shell.

        Todas las referencias entre diccionarios usan DynamicResource, nunca StaticResource:
        una referencia StaticResource entre archivos distintos fue exactamente la causa del
        crash de navegación de D1.1.

        Auditoría de estilo 2026-09-20 — ninguna vista los consume hoy (0 usos por grep en
        src/*.xaml y *.cs), pero WorkspaceComponentStyleTests.cs (tests/Nexo.App.Tests) ejercita
        uno por uno los que están en su TheoryData para evitar justo el crash de D1.1 que
        describe el párrafo de arriba. Esos 15 no se borran: el audit que pidió esta limpieza no
        vio ese archivo de pruebas. WorkspaceToolbarStyle sí se borró: no está en ese TheoryData
        ni lo usa ninguna vista, así que es el caso A genuino que el audit original pedía.
        ================================================================================
    -->

    <Style x:Key="WorkspaceSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,9" />
    </Style>

    <Style x:Key="WorkspaceSectionSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!--
        Tarjeta pulsable. Es un Button y no un Border con MouseDown para que funcione con
        teclado (Enter y Espacio), aparezca en el orden de tabulación y exponga su nombre
        accesible sin trabajo extra en cada vista.
    -->
    <Style x:Key="WorkspaceInteractiveCardStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CardSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RadiusMedium}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CardSurface" Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="CardSurface" Property="BorderBrush" Value="{DynamicResource BrushFocusRing}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CardSurface" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CardSurface" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WorkspaceMetricValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="WorkspaceMetricLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextTertiary}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!--
        Chip de estado. El color por sí solo no comunica el estado (requisito de
        accesibilidad): el chip siempre lleva texto, y el color solo lo refuerza.
    -->
    <Style x:Key="WorkspaceStatusChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="WorkspaceStatusChipTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="WorkspaceEmptyStateTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="WorkspaceEmptyStateDetailStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextTertiary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!--
        Estado de error recuperable. Se muestra dentro del workspace, nunca como diálogo
        modal: un fallo debe informar y dejar seguir usando Sakura.
    -->
    <Style x:Key="WorkspaceErrorStateStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushError}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
        <Setter Property="Padding" Value="13" />
    </Style>

    <Style x:Key="WorkspaceErrorStateTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="WorkspaceUnavailableStateStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
        <Setter Property="Padding" Value="13" />
    </Style>

    <Style x:Key="WorkspaceLoadingTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextTertiary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="WorkspaceDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BrushBorder}" />
        <Setter Property="Margin" Value="0,14" />
    </Style>

    <Style x:Key="WorkspaceSearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource CompactTextBoxStyle}">
        <Setter Property="Height" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
        Auditoría de estilo 2026-09-20 — este ControlTemplate de ListBoxItem (superficie con
        hover, selección y foco de teclado) estaba copiado letra por letra en ModelManagerWindow y
        VisionTargetPickerWindow, y una tercera vez, ligeramente distinta, en CommandCenterWindow.
        Se comparte aquí. CommandCenterWindow no adopta la plantilla entera: necesita un radio
        distinto (16, no 14), depende de IsEnabled por fila y su hover es el cristal translúcido
        BrushGlassHover en vez del BrushSurfaceHover sólido de aquí, así que mantiene su propio
        ControlTemplate y solo parte de este Style (BasedOn) para no repetir
        Margin/FocusVisualStyle.
    -->
    <Style x:Key="SakuraListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemSurface"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMedium}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource BrushAccentSoft}" />
                            <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{DynamicResource BrushAccentBorder}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Auditoría de estilo 2026-09-20 — el mismo DropShadowEffect (BlurRadius 24, ShadowDepth 6,
        Opacity 0.35, negro) estaba escrito literal en las cinco ventanas "píldora"
        (AssignmentDraftWindow, FeedbackWindow, FileSearchWindow, QuickCaptureWindow,
        SelectionActionsWindow). Un solo recurso compartido para las cinco.
    -->
    <DropShadowEffect x:Key="PillWindowShadowEffect"
                       BlurRadius="24"
                       ShadowDepth="6"
                       Opacity="0.35"
                       Color="{DynamicResource ColorShadow}" />

</ResourceDictionary>
