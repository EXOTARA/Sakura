<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Nexo.App.Views.Controls">
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="UserControl">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="Background" Value="#FA171D28" />
        <Setter Property="BorderBrush" Value="#4CFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        2026-09-15 — el menú del clic derecho con el tema de Sakura. Sin estilo, WPF lo dibujaba con su
        fondo claro de Windows y el texto claro del tema encima: casi no se leía (Adler, con una captura).
        Vale también para el menú de cortar, copiar y pegar de los cuadros de texto.
    -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="Background" Value="#FA171D28" />
        <Setter Property="BorderBrush" Value="#40FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="0,0,8,8"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.35" Color="{DynamicResource ColorShadow}" />
                        </Border.Effect>
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemSurface"
                            MinWidth="190"
                            Padding="12,7"
                            Background="Transparent"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGesture" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Margin="24,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource BrushTextTertiary}"
                                       FontSize="12" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource BrushAccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ItemSurface" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,4" Background="#26FFFFFF" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 2026-09-15 — un botón que se ve como un enlace: sin el fondo celeste de Windows al pasar el ratón. -->
    <Style x:Key="LinkButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Un TextBlock y no un ContentPresenter: el estilo general de TextBlock pondría el texto blanco. -->
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <TextBlock x:Name="Label"
                                   Text="{TemplateBinding Content}"
                                   TextWrapping="Wrap"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Label" Property="Opacity" Value="0.6" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Label" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCallout}" />
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightBody}" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle1}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
        <Setter Property="Padding" Value="{DynamicResource InsetCard}" />
    </Style>

    <Style x:Key="SubtleCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
        <Setter Property="Padding" Value="{DynamicResource InsetCard}" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMedium}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource BrushSurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource BrushAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.68" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="9,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="NavBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            controls:PillCorner.IsPill="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavBorder"
                                    Property="Background"
                                    Value="{DynamicResource BrushSurfaceHover}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource BrushTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="NavBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource BrushAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="NavBorder" Property="Opacity" Value="0.72" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Sakura Shell v1 (Diseño D1) — estilos reutilizables del marco principal (barra lateral,
        marca, encabezado de página, superficie de contenido). Sustituyen a los estilos locales
        que vivían en MainWindow.xaml para que el lenguaje visual del shell sea parte del
        Design System, no un detalle de implementación de una sola ventana.
    -->
    <Style x:Key="SakuraNavigationIconStyle" TargetType="Path">
        <Setter Property="Width" Value="{DynamicResource NavigationIconSize}" />
        <Setter Property="Height" Value="{DynamicResource NavigationIconSize}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource NavigationIconStrokeThickness}" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <!--
        Diseño D2.0 (corrección) — el estado seleccionado se expresa con un trazo MÁS GRUESO,
        nunca con relleno.

        Antes, esta variante ponía StrokeThickness=0 + Fill. Los iconos de Brand.xaml son
        geometrías de LÍNEA (trazos abiertos: la casa de Inicio, el ecualizador de Sistema, los
        deslizadores de Personalizar), no siluetas cerradas rellenables. Rellenarlas producía dos
        fallos medidos con render real (ver el informe de D2): los contornos cerrados se volvían
        bloques sólidos — Sistema 95.6 % y Hoy 93.2 % de cobertura de tinta frente a ~11 % en
        estado normal — y los trazos de detalle interiores, al no encerrar área, desaparecían;
        Personalizar, que son solo segmentos, se quedaba en 0 % (icono invisible).

        Mantener el trazo preserva la silueta exacta del icono no seleccionado, que es el
        requisito de aceptación, y el grosor sigue siendo una señal de estado independiente del
        color (junto con el indicador, la superficie elevada y el peso del texto), así que el
        estado activo sigue sin depender solo del color.
    -->
    <Style x:Key="SakuraNavigationIconSelectedStyle"
           TargetType="Path"
           BasedOn="{StaticResource SakuraNavigationIconStyle}">
        <Setter Property="StrokeThickness" Value="{DynamicResource NavigationIconStrokeThicknessSelected}" />
    </Style>

    <Style x:Key="SakuraNavigationItemStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
        <Setter Property="Height" Value="46" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="260" />
        <Setter Property="ToolTipService.ShowDuration" Value="3200" />
        <Setter Property="ToolTipService.Placement" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="NavBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusLarge}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="NavBorder" Property="BorderBrush" Value="{DynamicResource BrushFocusRing}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="NavBorder" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="NavBorder" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SakuraSidebarToggleStyle" TargetType="Button">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusLarge}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource BrushFocusRing}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SakuraPageTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle1}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SakuraPageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeFootnote}" />
    </Style>

    <Style x:Key="SakuraShellCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusShell}" />
    </Style>

    <!-- Blanco sobre el acento rosa daba 2,86:1; la tinta oscura conserva 6,74:1. -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource BrushBackground}" />
        <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="17,11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!--
                        El relleno va en el ContentPresenter. Sin él —así estuvo hasta el 2026-09-14— el
                        Padding de 17,11 no llegaba a ninguna parte: la píldora medía lo mismo que su
                        texto y en la bienvenida «Siguiente» y «Terminar» se veían recortados, pegados
                        al borde. Afectaba a todos los botones principales y secundarios.
                    -->
                    <Border x:Name="PrimaryBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            controls:PillCorner.IsPill="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PrimaryBorder" Property="BorderBrush" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Diseño D29 — tarjeta de tema en la galería de Apariencia. BorderBrush y BorderThickness se
        pasan por TemplateBinding a propósito: el código detrás fija esos dos valores directamente
        en la instancia del botón que corresponde al tema activo —un valor de instancia siempre
        gana sobre el de un Setter de estilo—, así que resaltar "este es el tema puesto ahora" no
        necesita un trigger nuevo por cada tema de la galería, solo mirar qué acento coincide.
    -->
    <Style x:Key="ThemeCardButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CardBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RadiusMedium}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CardBorder" Property="Background"
                                    Value="{DynamicResource BrushSurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CardBorder" Property="Opacity" Value="0.82" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
        <!--
            Con borde: el secundario tiene el mismo fondo que las tarjetas donde suele ir, y sin él los
            accesos rápidos del asistente se leían como texto suelto, no como botones.
        -->
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="PromptTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource BrushInput}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="13,11" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="SelectionBrush" Value="{DynamicResource BrushAccentSoft}" />
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource PromptTextBoxStyle}" />

    <Style x:Key="CompactTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource PromptTextBoxStyle}">
        <Setter Property="Height" Value="42" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!--
        Diseño D25 — el cuadro de la clave de acceso. No había ningún estilo para PasswordBox porque
        hasta ahora no había ninguno en la aplicación: la clave se pedía como nombre de una variable
        de entorno, en un TextBox normal. Sin estilo, Windows lo dibuja con su tema claro, y una caja
        blanca en mitad del tema oscuro se lee como un error de la aplicación justo en el paso donde
        alguien está pegando una credencial.
    -->
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource BrushInput}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="13,11" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
        Diseño D26 — el estilo anterior solo fijaba Foreground, Background y BorderBrush, y eso no
        basta: la plantilla por omisión de WPF dibuja su propio marco con brochas fijas del tema del
        sistema e ignora las que se le pasen. El resultado era una caja blanca de Windows con texto
        casi blanco encima — ilegible sobre el tema oscuro, en todas las listas desplegables de la
        aplicación. No se veía porque estaban enterradas en el muro de ajustes; al reorganizarlo
        quedaron a la vista. Para mandar de verdad sobre el color hay que reemplazar la plantilla.
    -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource BrushInput}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="OpenToggle"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Surface"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            CornerRadius="{DynamicResource RadiusSmall}"
                                            SnapsToDevicePixels="True">
                                        <Path x:Name="Arrow"
                                              Width="9"
                                              Height="5.5"
                                              Margin="0,0,12,0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Data="M0,0 L4.5,5 L9,0"
                                              Stretch="Fill"
                                              Stroke="{DynamicResource BrushTextSecondary}"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Surface" Property="BorderBrush"
                                                    Value="{DynamicResource BrushAccentBorder}" />
                                            <Setter TargetName="Arrow" Property="Stroke"
                                                    Value="{DynamicResource BrushAccent}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Surface" Property="BorderBrush"
                                                    Value="{DynamicResource BrushAccentBorder}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!--
                            El margen derecho deja hueco para la flecha; sin él, un nombre de modelo
                            largo se dibujaría por debajo de ella.
                        -->
                        <!--
                            Los tres enlaces del elemento seleccionado usan Binding con
                            RelativeSource y no TemplateBinding, y no es indiferente:
                            SelectionBoxItemTemplate es una propiedad de solo lectura que WPF
                            rellena DESPUÉS de aplicar la plantilla, y TemplateBinding —que se
                            resuelve una sola vez y no vuelve a mirar— se queda con el valor vacío
                            del principio. El efecto era que DisplayMemberPath dejaba de tener
                            efecto y el desplegable mostraba el objeto en crudo,
                            "AiProviderChoice { Kind = Disabled, … }", en vez de su nombre.
                        -->
                        <!--
                            Diseño D47 — el color del texto elegido se declara y no se hereda: con
                            TemplateBinding tomaba el gris apagado del contenedor del desplegable y
                            quedaba con tan poco contraste que costaba leerlo hasta ampliando la
                            pantalla.
                        -->
                        <ContentPresenter x:Name="SelectedItemPresenter"
                                          Margin="11,8,30,8"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          IsHitTestVisible="False"
                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                                          ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                          ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource TemplatedParent}}"
                                          TextElement.Foreground="{DynamicResource BrushTextPrimary}" />

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               MinWidth="{TemplateBinding ActualWidth}"
                               MaxHeight="{TemplateBinding MaxDropDownHeight}">
                            <Border Margin="0,4,0,0"
                                    Padding="4"
                                    Background="{DynamicResource BrushSurfaceRaised}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusMedium}"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="{DynamicResource ColorShadow}" />
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

