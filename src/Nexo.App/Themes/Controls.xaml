    <!--
        2026-09-14 — el deslizador líquido, el mismo de los controles rápidos pero en horizontal, para
        los volúmenes de la pestaña Audio (Adler).

        La plantilla conserva un Track de verdad con sus RepeatButton y su Thumb, todos transparentes:
        el arrastre, el clic en un punto, el teclado y el lector de pantalla siguen siendo los del
        Slider. Lo que se ve lo pinta LiquidSliderTrack, colocado debajo y sin recibir clics. El
        pulgar mide lo mismo que el hueco que el dibujo reserva al pomo, para que vayan a la par.
    -->
    <Style x:Key="LiquidSliderTransparentPartStyle" TargetType="Control">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        2026-09-15 — teclas pequeñas para las ventanas flotantes (paleta, Command Center, selector de
        zona). Recibe las partes de un atajo («Ctrl», «Enter») como ItemsSource. Mismo dibujo que las
        teclas de la pestaña Cheats, en tamaño de pie de ventana y con colores que se leen sobre cristal.
    -->
    <Style x:Key="CompactKeycapsStyle" TargetType="ItemsControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Border Margin="0,0,3,0"
                            MinWidth="20"
                            Padding="6,1,6,2"
                            CornerRadius="5"
                            Background="#1FFFFFFF"
                            BorderBrush="#30FFFFFF"
                            BorderThickness="1,1,1,2">
                        <TextBlock Text="{Binding}"
                                   HorizontalAlignment="Center"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                    </Border>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        2026-09-15 — botón pequeño y redondo para atajos: los nombres de modelos recomendados y los
        botones para seguir una respuesta («Más corto», «¿Primer paso?»…).
    -->
    <Style x:Key="SoftChipButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
