<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Sakura Premium: neutral graphite surfaces with restrained floral accents. -->
    <Color x:Key="ColorBackground">#0C0E14</Color>
    <Color x:Key="ColorSurface">#111528</Color>
    <Color x:Key="ColorSurfaceRaised">#151922</Color>
    <Color x:Key="ColorSurfaceHover">#202630</Color>
    <Color x:Key="ColorInput">#0F131B</Color>
    <Color x:Key="ColorBorder">#2A303A</Color>
    <Color x:Key="ColorTextPrimary">#DFE1EA</Color>
    <Color x:Key="ColorTextSecondary">#AAAAB4</Color>
    <!-- El texto auxiliar también se lee: el gris anterior daba 3,49:1 sobre SurfaceHover. -->
    <Color x:Key="ColorTextTertiary">#969BA8</Color>
    <Color x:Key="ColorAccent">#C4889A</Color>
    <Color x:Key="ColorAccentSoft">#2C2027</Color>
    <Color x:Key="ColorAccentBorder">#80C4889A</Color>
    <Color x:Key="ColorCoolBlue">#6B9CC8</Color>
    <Color x:Key="ColorCoolBlueSoft">#1C2937</Color>
    <Color x:Key="ColorSuccess">#71CFA8</Color>
    <Color x:Key="ColorWarning">#DDBE72</Color>
    <Color x:Key="ColorDanger">#DF7E8A</Color>
    <Color x:Key="ColorSidebarSurface">#10131C</Color>

    <!--
        Auditoría de estilo 2026-09-20 — el negro de sombra se escribía como "Black" en algunos
        sitios y "#000000" en otros (17 sitios, mismo color, dos formas de escribirlo). Un solo
        token evita esa deriva sin cambiar el valor.
    -->
    <Color x:Key="ColorShadow">#000000</Color>

    <!--
        Auditoría de estilo 2026-09-20 — CommandCenterWindow y CommandPaletteWindow usan fondos hex
        fijos en vez de BrushSidebarSurface (que sí reacciona al tema) a propósito: son superficies
        de cristal translúcidas sobre el degradado del marco, un efecto distinto del panel lateral
        sólido. Se nombran para dejar constancia de que la diferencia es intencional, sin migrarlas
        a BrushSidebarSurface ni fundirlas entre sí (los tres colores son distintos).
    -->
    <Color x:Key="ColorCommandSearchSurface">#B20D121B</Color>
    <Color x:Key="ColorCommandExpandedSurface">#B20F141E</Color>
    <Color x:Key="ColorCommandCustomizationSurface">#E0181E29</Color>

    <!--
        Auditoría de estilo 2026-09-20 — fondo y borde del icono circular de avatar, repetidos
        letra por letra en CommandCenterWindow, CommandPaletteWindow, ModelManagerWindow y
        VisionTargetPickerWindow.
    -->
    <Color x:Key="ColorAvatarIconBackground">#66222938</Color>
    <Color x:Key="ColorAvatarIconBorder">#20FFFFFF</Color>

    <!--
        Auditoría de estilo 2026-09-20 (corrección de manager) — al pasar el ListBoxItem de
        CommandCenterWindow a compartir SakuraListBoxItemStyle por BasedOn, su hover se fue detrás
        con BrushSurfaceHover (sólido) y sustituyó al blanco al 8% translúcido que llevaba, pensado
        para la superficie de cristal de esa ventana. Sí era un cambio visual real, no una
        unificación neutra, así que se nombra aparte en vez de compartirse.
    -->
    <Color x:Key="ColorGlassHover">#14FFFFFF</Color>

    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceRaised" Color="{StaticResource ColorSurfaceRaised}" />
    <SolidColorBrush x:Key="BrushSurfaceHover" Color="{StaticResource ColorSurfaceHover}" />
    <SolidColorBrush x:Key="BrushInput" Color="{StaticResource ColorInput}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextTertiary" Color="{StaticResource ColorTextTertiary}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentSoft" Color="{StaticResource ColorAccentSoft}" />
    <SolidColorBrush x:Key="BrushAccentBorder" Color="{StaticResource ColorAccentBorder}" />
    <SolidColorBrush x:Key="BrushCoolBlue" Color="{StaticResource ColorCoolBlue}" />
    <SolidColorBrush x:Key="BrushCoolBlueSoft" Color="{StaticResource ColorCoolBlueSoft}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushSakuraGlow" Color="#E4BBC7" />
    <SolidColorBrush x:Key="BrushSidebarSurface" Color="{StaticResource ColorSidebarSurface}" />
    <SolidColorBrush x:Key="BrushCommandSearchSurface" Color="{StaticResource ColorCommandSearchSurface}" />
    <SolidColorBrush x:Key="BrushCommandExpandedSurface" Color="{StaticResource ColorCommandExpandedSurface}" />
    <SolidColorBrush x:Key="BrushCommandCustomizationSurface" Color="{StaticResource ColorCommandCustomizationSurface}" />
    <SolidColorBrush x:Key="BrushAvatarIconBackground" Color="{StaticResource ColorAvatarIconBackground}" />
    <SolidColorBrush x:Key="BrushAvatarIconBorder" Color="{StaticResource ColorAvatarIconBorder}" />
    <SolidColorBrush x:Key="BrushGlassHover" Color="{StaticResource ColorGlassHover}" />

    <!--
        Diseño D1.1 (hotfix) — BrushTextMuted, BrushError y BrushFocusRing vivían en Brushes.xaml
        referenciando estos Color* por StaticResource *entre archivos distintos*. Esa referencia
        cruzada es frágil en WPF: solo se resuelve de forma fiable cuando ambas claves están en el
        mismo diccionario. Antes de la Fase de diseño nada consumía BrushFocusRing, así que el
        fallo quedó latente; el primer consumidor real (el anillo de foco de la barra lateral)
        lo expuso como un XamlParseException no controlado al navegar. Se movieron aquí, junto a
        los Color* que referencian, para que la resolución sea siempre dentro del mismo archivo.
    -->
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextTertiary}" />
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushFocusRing" Color="{StaticResource ColorAccentBorder}" />
</ResourceDictionary>
