<Window x:Class="Nexo.App.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enviar comentarios a Sakura"
        Width="480"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <!-- 2026-09-16 — comentarios de gente real. Nada se envía solo: se abre el navegador o se copia. -->
    <Border Margin="24"
            Padding="18,16"
            CornerRadius="22"
            Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="¿Qué te gustó, qué te confundió o qué falla?"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0"
                       Text="Cuanto más concreto, mejor: qué hiciste, qué esperabas y qué pasó."
                       TextWrapping="Wrap"
                       Style="{StaticResource MutedTextStyle}" />
            <TextBox x:Name="FeedbackTextBox"
                     Margin="0,10,0,0"
                     Height="120"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource PromptTextBoxStyle}"
                     AutomationProperties.Name="Tu comentario"
                     TextChanged="FeedbackTextBox_TextChanged" />
            <CheckBox x:Name="IncludeVersionsCheckBox"
                      Margin="0,10,0,0"
                      IsChecked="True"
                      Content="Añadir la versión de Sakura y de Windows" />
            <TextBlock x:Name="StatusText"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Style="{StaticResource MutedTextStyle}"
                       Text="«Abrir en GitHub» te lleva a la página de reportes del proyecto con el texto ya escrito (necesita una cuenta de GitHub). Si no tienes, cópialo y mándalo por donde prefieras." />
            <Grid Margin="0,12,0,0">
                <Button HorizontalAlignment="Left"
                        Content="Cerrar"
                        Padding="14,7"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Close_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CopyButton"
                            Content="Copiar"
                            Padding="14,7"
                            IsEnabled="False"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Copy_Click" />
                    <Button x:Name="OpenButton"
                            Margin="7,0,0,0"
                            Content="Abrir en GitHub"
                            Padding="14,7"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Open_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
