<Window x:Class="Nexo.App.ModelManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a11y="clr-namespace:Nexo.App.Views.Controls"
        Title="Modelos locales de Sakura"
        Width="640"
        Height="640"
        MinWidth="560"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBackground}"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <!--
        2026-09-15 — el gestor con el lenguaje del resto de Sakura:
        · la barra de título del tema y la flor en la cabecera;
        · el estado de Ollama como una píldora con su punto de color;
        · cada modelo en una fila con icono, «En uso» en el que Sakura tiene elegido y el tamaño aparte;
        · la selección con el acento, no la franja azul de Windows;
        · atajos para los modelos que Sakura recomienda, una barra de progreso que avanza suave, cifras
          en castellano («1,2 GB de 3,4 GB») y un botón para cancelar la descarga, que antes no había;
        · eliminar se confirma en la propia ventana, al lado del botón, y no con un cuadro de Windows.
    -->
    <Grid Margin="22,20,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="44"
                    Height="44"
                    VerticalAlignment="Top"
                    CornerRadius="14"
                    Background="{DynamicResource BrushAccentSoft}"
                    BorderBrush="{DynamicResource BrushAccentBorder}"
                    BorderThickness="1">
                <a11y:DecorativeMark Focusable="False"
                                     Width="24"
                                     Height="24"
                                     Style="{StaticResource SakuraFlowerMarkStyle}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Modelos locales" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Margin="0,3,0,0"
                           Text="Los modelos que usa Sakura sin conexión. Se descargan una vez y se quedan en tu equipo."
                           TextWrapping="Wrap"
                           Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="StatusPill"
                    HorizontalAlignment="Left"
                    Padding="10,5,12,6"
                    CornerRadius="13"
                    Background="#12FFFFFF"
                    BorderBrush="#1CFFFFFF"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot"
                             Width="7"
                             Height="7"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource BrushTextTertiary}" />
                    <TextBlock x:Name="StatusText"
                               VerticalAlignment="Center"
                               Text="Comprobando Ollama…"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource FontSizeFootnote}"
                               Foreground="{DynamicResource BrushTextSecondary}" />
                </StackPanel>
            </Border>
            <Button AutomationProperties.Name="Actualizar"
                    x:Name="RefreshButton"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    ToolTip="Volver a leer los modelos instalados"
                    Click="RefreshButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Width="14"
                          Height="14"
                          Margin="0,0,7,0"
                          VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5"
                          Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="{StaticResource IconSakuraRoutines}">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="RefreshIconRotation" />
                        </Path.RenderTransform>
                    </Path>
                    <TextBlock Text="Actualizar" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8" CornerRadius="20">
            <Grid>
                <ListBox AutomationProperties.Name="Modelos instalados"
                         x:Name="ModelsListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ModelsListBox_SelectionChanged"
                         MouseDoubleClick="ModelsListBox_MouseDoubleClick">
                    <!--
                        Auditoría de estilo 2026-09-20 — esta plantilla de ListBoxItem era una
                        copia letra por letra de la de VisionTargetPickerWindow. Ahora comparten
                        SakuraListBoxItemStyle (Controls.xaml); el padding y el radio de aquí ya
                        eran los mismos que trae el estilo base, así que no hace falta sobrescribir
                        nada.
                    -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource SakuraListBoxItemStyle}" />
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="38"
                                        Height="38"
                                        CornerRadius="12"
                                        Background="{DynamicResource BrushAvatarIconBackground}"
                                        BorderBrush="{DynamicResource BrushAvatarIconBorder}"
                                        BorderThickness="1">
                                    <Path Width="18"
                                          Height="18"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Data="{StaticResource IconMetricMemory}"
                                          Stroke="{DynamicResource BrushAccent}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource BrushTextPrimary}" />
                                        <Border Margin="8,0,0,0"
                                                Padding="7,1,7,2"
                                                VerticalAlignment="Center"
                                                CornerRadius="8"
                                                Background="{DynamicResource BrushAccentSoft}"
                                                BorderBrush="{DynamicResource BrushAccentBorder}"
                                                BorderThickness="1"
                                                Visibility="{Binding InUseVisibility}">
                                            <TextBlock Text="En uso"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushAccent}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding Detail}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource BrushTextSecondary}" />
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Padding="9,3,9,4"
                                        VerticalAlignment="Center"
                                        CornerRadius="10"
                                        Background="#14FFFFFF">
                                    <TextBlock Text="{Binding SizeDisplay}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextSecondary}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="EmptyStatePanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <a11y:DecorativeMark Focusable="False"
                                         Width="30"
                                         Height="30"
                                         Opacity="0.7"
                                         Style="{StaticResource SakuraFlowerMarkStyle}" />
                    <TextBlock x:Name="EmptyStateTitle"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Text="Todavía no hay modelos"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}" />
                    <TextBlock x:Name="EmptyStateText"
                               Margin="0,4,0,0"
                               MaxWidth="360"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="Descarga el recomendado aquí abajo para que Sakura pueda responder sin conexión."
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="DownloadCard"
                Grid.Row="3"
                Margin="0,12,0,0"
                Style="{StaticResource SubtleCardStyle}"
                CornerRadius="20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Descargar un modelo" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel x:Name="SuggestionChips" Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="RecommendedChip"
                                AutomationProperties.Name="Usar el nombre del modelo recomendado, qwen3.5:4b"
                                Style="{StaticResource SoftChipButtonStyle}"
                                Tag="qwen3.5:4b"
                                Click="SuggestionChip_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="qwen3.5:4b" />
                                <TextBlock Margin="6,0,0,0" Text="Recomendado" Foreground="{DynamicResource BrushAccent}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="Usar el nombre gemma3:4b"
                                Margin="6,0,0,0"
                                Style="{StaticResource SoftChipButtonStyle}"
                                Tag="gemma3:4b"
                                Content="gemma3:4b"
                                Click="SuggestionChip_Click" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ModelNameTextBox"
                             AutomationProperties.Name="Nombre del modelo"
                             Text="qwen3.5:4b"
                             Style="{StaticResource CompactTextBoxStyle}" />
                    <Grid Grid.Column="1" Margin="10,0,0,0">
                        <Button AutomationProperties.Name="Descargar"
                                x:Name="InstallButton"
                                Content="Descargar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="InstallButton_Click" />
                        <Button AutomationProperties.Name="Cancelar la descarga"
                                x:Name="CancelDownloadButton"
                                Content="Cancelar"
                                Visibility="Collapsed"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CancelDownloadButton_Click" />
                    </Grid>
                </Grid>

                <StackPanel x:Name="DownloadProgressPanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <a11y:RoundedClipBorder x:Name="DownloadTrack"
                                            Height="8"
                                            CornerRadius="4"
                                            Background="#1CFFFFFF"
                                            SizeChanged="DownloadTrack_SizeChanged"
                                            AutomationProperties.Name="Progreso de la descarga">
                        <Border x:Name="DownloadFill"
                                HorizontalAlignment="Left"
                                CornerRadius="4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop x:Name="DownloadFillStart" Color="#FFB9577D" Offset="0" />
                                    <GradientStop x:Name="DownloadFillEnd" Color="#FFE8739E" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="DownloadFillTranslate" />
                            </Border.RenderTransform>
                        </Border>
                    </a11y:RoundedClipBorder>
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DownloadStatusText"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <TextBlock x:Name="DownloadPercentText"
                                   Grid.Column="1"
                                   Margin="10,0,0,0"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushAccent}" />
                    </Grid>
                </StackPanel>

                <TextBlock x:Name="DownloadResultText"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid x:Name="FooterActions">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button AutomationProperties.Name="Eliminar seleccionado"
                        x:Name="DeleteButton"
                        Content="Eliminar…"
                        IsEnabled="False"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="DeleteButton_Click" />
                <Button AutomationProperties.Name="Cerrar" Grid.Column="2"
                        Margin="0,0,10,0"
                        Content="Cerrar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True" Click="CloseButton_Click" />
                <Button AutomationProperties.Name="Usar seleccionado"
                        x:Name="UseButton"
                        Grid.Column="3"
                        Content="Usar este modelo"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="UseButton_Click" />
            </Grid>

            <!-- Confirmación en el mismo sitio del botón: se ve qué se va a borrar y se deshace con un clic. -->
            <Border x:Name="ConfirmDeletePanel"
                    Padding="14,8,8,8"
                    CornerRadius="16"
                    Background="#1FE0566B"
                    BorderBrush="#66E0566B"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ConfirmDeleteText"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushTextPrimary}" />
                    <Button AutomationProperties.Name="No eliminar"
                            x:Name="KeepModelButton"
                            Grid.Column="1"
                            Margin="10,0,8,0"
                            Content="No"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="KeepModelButton_Click" />
                    <Button AutomationProperties.Name="Sí, eliminar"
                            x:Name="ConfirmDeleteButton"
                            Grid.Column="2"
                            Content="Sí, eliminar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Background="{DynamicResource BrushDanger}"
                            Click="ConfirmDeleteButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
