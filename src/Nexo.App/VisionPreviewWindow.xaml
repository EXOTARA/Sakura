<Window x:Class="Nexo.App.VisionPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vista previa de Lens"
        Width="760"
        Height="600"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}"
        Foreground="{StaticResource BrushTextPrimary}"
        xmlns:a11y="clr-namespace:Nexo.App.Views.Controls"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        SourceInitialized="Window_SourceInitialized">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="HeaderPanel">
            <StackPanel Orientation="Horizontal">
                <a11y:DecorativeMark Focusable="False"
                                     Width="22"
                                     Height="22"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center"
                                     Style="{StaticResource SakuraFlowerMarkStyle}" />
                <TextBlock Text="Revisa la captura antes de compartirla"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeTitle2}"
                           FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock x:Name="SourceTitleText"
                       Margin="0,5,0,14"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource BrushTextSecondary}" />
        </StackPanel>

        <a11y:RoundedClipBorder x:Name="ImageCard"
                Grid.Row="1"
                Padding="8"
                CornerRadius="20"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                Background="#080A0F">
            <ScrollViewer Focusable="True" AutomationProperties.Name="Vista previa de la captura: desplazar" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Image AutomationProperties.Name="{Binding Text, ElementName=SourceTitleText, StringFormat=Captura de {0}}" x:Name="PreviewImage"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True" />
            </ScrollViewer>
        </a11y:RoundedClipBorder>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterNote"
                       VerticalAlignment="Center"
                       Text="La imagen se mantendrá solo hasta terminar el análisis o descartarla."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource BrushTextSecondary}"
                       FontSize="{DynamicResource FontSizeFootnote}" />
            <Button AutomationProperties.Name="Descartar" Grid.Column="1"
                    Margin="12,0,0,0"
                    Padding="14,8"
                    Content="Descartar"
                    Style="{StaticResource SecondaryButtonStyle}"
                    x:Name="DiscardButton" IsCancel="True" Click="DiscardButton_Click" />
            <!-- 2026-09-15 — con una captura de la pestaña Captura: guardarla o copiarla, además de preguntar. -->
            <StackPanel x:Name="KeepActions" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed">
                <Button AutomationProperties.Name="Copiar la captura"
                        x:Name="CopyButton"
                        Margin="10,0,0,0"
                        Padding="14,8"
                        Content="Copiar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CopyButton_Click" />
                <Button AutomationProperties.Name="Guardar la captura"
                        Margin="10,0,0,0"
                        Padding="14,8"
                        Content="Guardar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="SaveButton_Click" />
            </StackPanel>
            <Button AutomationProperties.Name="Usar captura" Grid.Column="3"
                    x:Name="UseButton"
                    Margin="10,0,0,0"
                    Padding="14,8"
                    Content="Usar captura"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="UseButton_Click" />
        </Grid>
    </Grid>
</Window>
