<Window x:Class="Nexo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Nexo.App.Views"
        Title="Sakura"
        Width="560"
        Height="790"
        MinWidth="460"
        MinHeight="680"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        Closed="Window_Closed"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        Diseño D62 — sin esto la ventana no tiene marco, y sin marco DWM no le dibuja sombra.
        Medido: los píxeles justo por fuera del borde valían lo mismo que el escritorio a cien de
        distancia. La barra de título mide cero y el borde de redimensión también, así que no
        aparece nada de Windows dentro; lo único que se recupera es el marco que sostiene la
        sombra y el cristal.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <Style x:Key="HeaderCommandButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource BrushAccentBorder}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource BrushFocusRing}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        Diseño D62 — la ventana ya no dibuja su propio marco: lo compone Windows.

        Hasta D61 esto era un Grid con dieciséis píxeles de margen para que cupiera una sombra
        pintada a mano (un DropShadowEffect en un borde propio, con BitmapCache, detrás del borde
        con el contenido) y la ventana entera iba con AllowsTransparency, que obliga a WPF a
        componer por software: nada de la tarjeta gráfica, y cada carácter escrito en el chat
        volvía a desenfocar la ventana completa.

        DWM hace las tres cosas —desenfoque, esquinas y sombra— fuera de nuestro proceso y en la
        GPU. Lo que queda aquí es una superficie que llega hasta el borde de la ventana.

        2026-09-14 — las esquinas vuelven a ser nuestras, de 34 como el panel superior: la ventana es
        cristal transparente (SakuraWindowChrome.ApplyRounded) y ShellSurface dibuja el radio. Sigue
        en la GPU; lo que se dejó es el desenfoque del acrílico, elegido así por Adler.

        El margen desaparece, así que el ancho guardado en preferencias vale ahora lo que se ve;
        la separación con el borde de la pantalla la pone PositionWindow.
    -->
    <Grid x:Name="ShellBorder"
          Opacity="0"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="ShellTranslate" X="24" />
            </TransformGroup>
        </Grid.RenderTransform>

        <!--
            El fondo lo pone ApplyShellOpacity: opaco cuando no hay fondo del sistema detrás,
            y con la transparencia elegida por el usuario cuando sí lo hay, que es lo que deja
            ver lo que hay detrás. El radio también lo pone el código, con la ventana ya en modo
            cristal; si ese modo no está disponible, las esquinas vuelven a ser las de Windows.
        -->
        <Border x:Name="ShellSurface"
                SnapsToDevicePixels="True">
        <Grid ClipToBounds="True">
            <Grid x:Name="ShellLayoutGrid" Margin="13">
                <!--
                    Las dos columnas son intercambiables: cuando Sakura se acopla al borde izquierdo
                    de la pantalla, el rail de navegación pasa a la columna 1 y el contenido a la 0.
                    Antes el rail estaba clavado en la columna 0 y quedaba en el lado interior,
                    lejos del borde por el que la ventana aparece — el menú se quedaba donde no
                    estaba Sakura. Los anchos también se intercambian; por eso ninguno es fijo aquí.
                -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ShellFirstColumn" Width="Auto" />
                    <ColumnDefinition x:Name="ShellSecondColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="SideRailBorder"
                        Grid.Column="0"
                        Width="{DynamicResource SidebarWidthCollapsed}"
                        Margin="0"
                        Padding="7,10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource BrushSidebarSurface}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusShell}"
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18"
                                          ShadowDepth="4"
                                          Opacity="0.25"
                                          Color="Black" />
                    </Border.Effect>

                    <Grid x:Name="SideRailContentGrid" Width="52" HorizontalAlignment="Left" ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button x:Name="SideRailToggleButton"
                                Style="{StaticResource SakuraSidebarToggleStyle}"
                                ToolTip="Expandir o contraer navegación"
                                AutomationProperties.Name="Expandir o contraer navegación"
                                Click="SideRailToggleButton_Click">
                            <Grid x:Name="SideRailToggleGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="SideRailToggleIconColumn" Width="46" />
                                    <ColumnDefinition x:Name="SideRailToggleTextColumn" Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="SideRailToggleIcon"
                                        Width="42"
                                        Height="42"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource BrushAccentSoft}"
                                        BorderBrush="{DynamicResource BrushAccentBorder}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                    <!--
                                        Diseño D64 — el botón que pliega el rail lleva la marca de
                                        Sakura, elegida por Adler. Antes llevaba un panel con un
                                        chevrón que giraba según el lado; el chevrón se va con él
                                        porque a diecinueve píxeles la flor y una flecha encima no
                                        caben sin ensuciarse. Qué hace el botón lo siguen diciendo
                                        su nombre de accesibilidad y su descripción emergente, que
                                        no cambian.
                                    -->
                                    <Grid Width="21" Height="21">
                                        <Path Data="{StaticResource IconSakuraMark}"
                                              Width="19"
                                              Height="19"
                                              Stretch="Uniform"
                                              Fill="{DynamicResource BrushAccent}" />
                                    </Grid>
                                </Border>
                                <StackPanel x:Name="SideRailBrandText"
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                    <TextBlock Text="Sakura"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Tu Windows, en flor"
                                               Margin="0,2,0,0"
                                               Style="{StaticResource SakuraPageSubtitleStyle}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <StackPanel Grid.Row="1"
                                    x:Name="NavigationGrid"
                                    Margin="0,14,0,8"
                                    VerticalAlignment="Top">
                            <Button x:Name="HomeNavButton"
                                    Tag="Home"
                                    ToolTip="Inicio"
                                    AutomationProperties.Name="Inicio"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource SakuraNavigationItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="HomeNavIndicator" Grid.Column="0" Width="{DynamicResource NavigationIndicatorWidth}" Margin="0,6" CornerRadius="2" Background="{DynamicResource BrushAccent}" Visibility="Collapsed" />
                                    <Path Grid.Column="1" x:Name="HomeNavIcon" Style="{StaticResource SakuraNavigationIconStyle}" Data="{StaticResource IconSakuraHome}" />
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="HomeNavLabel" Text="Inicio" FontSize="{DynamicResource FontSizeBody}" Visibility="Collapsed" />
                                </Grid>
                            </Button>

                            <Button x:Name="AssistantNavButton"
                                    Tag="Assistant"
                                    ToolTip="Asistente"
                                    AutomationProperties.Name="Asistente"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource SakuraNavigationItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="AssistantNavIndicator" Grid.Column="0" Width="{DynamicResource NavigationIndicatorWidth}" Margin="0,6" CornerRadius="2" Background="{DynamicResource BrushAccent}" Visibility="Collapsed" />
                                    <Path Grid.Column="1" x:Name="AssistantNavIcon" Style="{StaticResource SakuraNavigationIconStyle}" Data="{StaticResource IconSakuraAssistant}" />
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="AssistantNavLabel" Text="Chat" FontSize="{DynamicResource FontSizeBody}" Visibility="Collapsed" />
                                </Grid>
                            </Button>

                            <Button x:Name="TasksNavButton"
                                    Tag="Tasks"
                                    ToolTip="Pendientes de hoy"
                                    AutomationProperties.Name="Pendientes de hoy"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource SakuraNavigationItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="TasksNavIndicator" Grid.Column="0" Width="{DynamicResource NavigationIndicatorWidth}" Margin="0,6" CornerRadius="2" Background="{DynamicResource BrushAccent}" Visibility="Collapsed" />
                                    <Path Grid.Column="1" x:Name="TasksNavIcon" Style="{StaticResource SakuraNavigationIconStyle}" Data="{StaticResource IconSakuraTasks}" />
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="TasksNavLabel" Text="Hoy" FontSize="{DynamicResource FontSizeBody}" Visibility="Collapsed" />
                                </Grid>
                            </Button>

                            <Button x:Name="FocusNavButton"
                                    Tag="Focus"
                                    ToolTip="Enfoque"
                                    AutomationProperties.Name="Enfoque"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource SakuraNavigationItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="FocusNavIndicator" Grid.Column="0" Width="{DynamicResource NavigationIndicatorWidth}" Margin="0,6" CornerRadius="2" Background="{DynamicResource BrushAccent}" Visibility="Collapsed" />
                                    <Path Grid.Column="1" x:Name="FocusNavIcon" Style="{StaticResource SakuraNavigationIconStyle}" Data="{StaticResource IconSakuraFocus}" />
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="FocusNavLabel" Text="Enfoque" FontSize="{DynamicResource FontSizeBody}" Visibility="Collapsed" />
                                </Grid>
                            </Button>

                            <Button x:Name="RoutinesNavButton"
                                    Tag="Routines"
                                    ToolTip="Rutinas"
                                    AutomationProperties.Name="Rutinas"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource SakuraNavigationItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="RoutinesNavIndicator" Grid.Column="0" Width="{DynamicResource NavigationIndicatorWidth}" Margin="0,6" CornerRadius="2" Background="{DynamicResource BrushAccent}" Visibility="Collapsed" />
                                    <Path Grid.Column="1" x:Name="RoutinesNavIcon" Style="{StaticResource SakuraNavigationIconStyle}" Data="{StaticResource IconSakuraRoutines}" />
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="RoutinesNavLabel" Text="Rutinas" FontSize="{DynamicResource FontSizeBody}" Visibility="Collapsed" />
                                </Grid>
                            </Button>

                            <Button x:Name="AudioNavButton"
                                    Tag="Audio"
                                    ToolTip="Audio"
                                    AutomationProperties.Name="Audio"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource SakuraNavigationItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="AudioNavIndicator" Grid.Column="0" Width="{DynamicResource NavigationIndicatorWidth}" Margin="0,6" CornerRadius="2" Background="{DynamicResource BrushAccent}" Visibility="Collapsed" />
                                    <Path Grid.Column="1" x:Name="AudioNavIcon" Style="{StaticResource SakuraNavigationIconStyle}" Data="{StaticResource IconSakuraAudio}" />
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="AudioNavLabel" Text="Audio" FontSize="{DynamicResource FontSizeBody}" Visibility="Collapsed" />
                                </Grid>
                            </Button>

                            <Button x:Name="CaptureNavButton"
                                    Tag="Capture"
                                    ToolTip="Captura"
                                    AutomationProperties.Name="Captura"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource SakuraNavigationItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="CaptureNavIndicator" Grid.Column="0" Width="{DynamicResource NavigationIndicatorWidth}" Margin="0,6" CornerRadius="2" Background="{DynamicResource BrushAccent}" Visibility="Collapsed" />
                                    <Path Grid.Column="1" x:Name="CaptureNavIcon" Style="{StaticResource SakuraNavigationIconStyle}" Data="{StaticResource IconSakuraCapture}" />
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="CaptureNavLabel" Text="Captura" FontSize="{DynamicResource FontSizeBody}" Visibility="Collapsed" />
                                </Grid>
                            </Button>

                            <Button x:Name="SystemNavButton"
                                    Tag="System"
                                    ToolTip="Sistema"
                                    AutomationProperties.Name="Sistema"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource SakuraNavigationItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="SystemNavIndicator" Grid.Column="0" Width="{DynamicResource NavigationIndicatorWidth}" Margin="0,6" CornerRadius="2" Background="{DynamicResource BrushAccent}" Visibility="Collapsed" />
                                    <Path Grid.Column="1" x:Name="SystemNavIcon" Style="{StaticResource SakuraNavigationIconStyle}" Data="{StaticResource IconSakuraSystem}" />
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="SystemNavLabel" Text="Sistema" FontSize="{DynamicResource FontSizeBody}" Visibility="Collapsed" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <Button Grid.Row="2"
                                x:Name="SettingsNavButton"
                                Tag="Settings"
                                ToolTip="Personalización y perfiles"
                                AutomationProperties.Name="Personalización y perfiles"
                                Click="SettingsButton_Click"
                                Style="{StaticResource SakuraNavigationItemStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="SettingsNavIndicator" Grid.Column="0" Width="{DynamicResource NavigationIndicatorWidth}" Margin="0,6" CornerRadius="2" Background="{DynamicResource BrushAccent}" Visibility="Collapsed" />
                                <Path Grid.Column="1" x:Name="SettingsNavIcon" Style="{StaticResource SakuraNavigationIconStyle}" Data="{StaticResource IconSakuraSettings}" />
                                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="SettingsNavLabel" Text="Personalizar" FontSize="{DynamicResource FontSizeBody}" Visibility="Collapsed" />
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <Grid x:Name="ShellContentGrid" Grid.Column="1" Margin="13,2,2,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="5,4,5,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="WorkspaceTitleText"
                                           Text="Inicio"
                                           MaxWidth="360"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SakuraPageTitleStyle}" />
                                <Border x:Name="WakeWordIndicator"
                                        Margin="11,1,0,0"
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource BrushSurfaceRaised}"
                                        CornerRadius="9"
                                        Visibility="Collapsed"
                                        ToolTip="La activación por voz escucha únicamente la frase configurada.">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7"
                                                 Height="7"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource BrushSuccess}" />
                                        <TextBlock x:Name="WakeWordIndicatorText"
                                                   Text="Sakura atenta"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ResourceModeIndicator"
                                        Margin="8,1,0,0"
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource BrushSurfaceRaised}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="ResourceModeDot"
                                                 Width="7"
                                                 Height="7"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource BrushWarning}" />
                                        <TextBlock x:Name="ResourceModeText"
                                                   Text="Equipo ocupado"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="FlowIndicator"
                                        Margin="8,1,0,0"
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource BrushAccentSoft}"
                                        CornerRadius="9"
                                        Visibility="Collapsed"
                                        ToolTip="Sakura está dictando: habla y pulsa Ctrl + Shift + D otra vez para escribir."
                                        AutomationProperties.Name="Sakura está escuchando tu dictado">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7"
                                                 Height="7"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource BrushAccent}" />
                                        <TextBlock Text="Dictando"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="LensIndicator"
                                        Margin="8,1,0,0"
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource BrushAccentSoft}"
                                        CornerRadius="9"
                                        Visibility="Collapsed"
                                        ToolTip="Sakura Lens está observando la ventana activa, con tu autorización."
                                        AutomationProperties.Name="Sakura Lens está observando la ventana activa">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7"
                                                 Height="7"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource BrushAccent}" />
                                        <TextBlock Text="Mirando"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!--
                            2026-09-14 — el temporizador va en la línea del subtítulo y no junto a los
                            botones. Al lado de los botones le quitaba el ancho al título, y con un
                            temporizador en marcha se leía «Asiste…», «Sister…», «Perso…». Visto al
                            preparar las capturas de la Store.
                        -->
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="WorkspaceSubtitleText"
                                       VerticalAlignment="Center"
                                       Text="Tu espacio de acciones y contexto"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource SakuraPageSubtitleStyle}" />
                            <views:FocusMiniTimer x:Name="FocusMiniTimerControl"
                                                   Grid.Column="1"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="9"
                                    Height="9"
                                    Margin="0,0,11,0"
                                    Background="{DynamicResource BrushSuccess}"
                                    CornerRadius="5"
                                    ToolTip="Sakura está activa"
                                    AutomationProperties.Name="Sakura está activa" />
                            <Button x:Name="CommandCenterButton"
                                    Width="42"
                                    Height="42"
                                    Margin="0,0,4,0"
                                    Padding="0"
                                    Style="{StaticResource HeaderCommandButtonStyle}"
                                    Click="CommandCenterButton_Click"
                                    ToolTip="Centro de comandos · Ctrl + K"
                                    AutomationProperties.Name="Abrir centro de comandos"
                                    AutomationProperties.HelpText="Ejecuta acciones de Sakura sin usar el ratón. Atajo: Ctrl + K.">
                                <Grid Width="19" Height="19">
                                    <Path Data="{StaticResource IconSakuraPlus}"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource BrushAccent}"
                                          StrokeThickness="1.75"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Grid>
                            </Button>
                            <Button x:Name="CommandPaletteButton"
                                    Width="42"
                                    Height="42"
                                    Padding="0"
                                    Style="{StaticResource HeaderCommandButtonStyle}"
                                    Click="CommandPaletteButton_Click"
                                    ToolTip="Preguntar a Sakura · Ctrl + Espacio"
                                    AutomationProperties.Name="Abrir paleta de comandos">
                                <Grid Width="19" Height="19">
                                    <Path Data="{StaticResource IconCommandPalette}"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource BrushAccent}"
                                          StrokeThickness="1.75"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Grid>
                            </Button>

                            <!--
                                Diseño D58 — una forma visible de recoger Sakura.

                                Escape ya la cierra, y ahora también desde fuera, pero un atajo no se
                                ve: quien no lo sepa no tiene ninguna señal de cómo quitarla de en
                                medio. El trazo es más fino que el de los otros dos y va en color
                                secundario a propósito —cerrar no es una acción que haya que invitar
                                a hacer, solo tiene que estar cuando se busca.
                            -->
                            <Button x:Name="HideShellButton"
                                    Width="42"
                                    Height="42"
                                    Margin="4,0,0,0"
                                    Padding="0"
                                    Style="{StaticResource HeaderCommandButtonStyle}"
                                    Click="HideShellButton_Click"
                                    ToolTip="Recoger Sakura · Esc"
                                    AutomationProperties.Name="Recoger Sakura"
                                    AutomationProperties.HelpText="Oculta la ventana sin cerrar Sakura. Atajo: Esc.">
                                <Grid Width="17" Height="17">
                                    <Path Data="{StaticResource IconSakuraClose}"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource BrushTextSecondary}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="5,0,5,5"
                            Padding="17"
                            Style="{StaticResource SakuraShellCardStyle}">
                        <!--
                            IsTabStop en falso: un ContentControl acepta el foco por omisión, y este
                            era una parada de Tab vacía entre «Recoger Sakura» y la vista. El Narrador
                            no decía nada en ella (oído el 2026-09-14 grabando su voz).
                        -->
                        <ContentControl x:Name="ModuleHost" IsTabStop="False" />
                    </Border>

                    <Grid Visibility="Collapsed">
                        <TextBlock x:Name="ClockText" Text="—" />
                        <TextBlock x:Name="DateText" Text="—" />
                        <TextBlock x:Name="HeaderCpuText" Text="—" />
                        <TextBlock x:Name="HeaderMemoryText" Text="—" />
                        <TextBlock x:Name="HeaderGpuText" Text="—" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        </Border>
    </Grid>
</Window>
