<Window x:Class="Nexo.App.RegionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a11y="clr-namespace:Nexo.App.Views.Controls"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#01000000"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        AutomationProperties.Name="Elegir una zona de la pantalla"
        AutomationProperties.LiveSetting="Polite"
        AutomationProperties.HelpText="Flechas mueven la zona; Mayús y flechas cambian su tamaño; Control afina; Enter confirma; Escape cancela.">
    <!--
        Diseño D84 — elegir una zona de la pantalla arrastrando.

        Es la TERCERA ventana con AllowsTransparency de la aplicación, y como las otras dos hay que
        justificarla: oscurece toda la pantalla y a la vez deja un hueco limpio por el que se ve lo
        que hay debajo. Eso es transparencia por píxel, y DWM no la da.

        A diferencia del resaltado de Lens, ésta SÍ recibe el ratón: seleccionar es su único trabajo.

        El fondo es #01000000 y no Transparent porque una ventana completamente transparente no
        recibe clics en WPF: el ratón la atraviesa. Un alfa de uno sobre 255 es invisible y sí los
        recibe.

        El velo son cuatro rectángulos ALREDEDOR del hueco, no un rectángulo claro encima. Pintar
        encima dejaría el velo por debajo y el texto de la zona elegida se leería apagado — que es
        justo el texto que hay que poder leer para saber si se ha seleccionado lo correcto.
    -->
    <Canvas x:Name="Root">
        <Rectangle x:Name="VeilTop" Fill="#8C000000" />
        <Rectangle x:Name="VeilBottom" Fill="#8C000000" />
        <Rectangle x:Name="VeilLeft" Fill="#8C000000" />
        <Rectangle x:Name="VeilRight" Fill="#8C000000" />

        <Rectangle x:Name="SelectionBorder"
                   Visibility="Collapsed"
                   Stroke="{DynamicResource BrushAccent}"
                   StrokeThickness="2"
                   RadiusX="6"
                   RadiusY="6" />

        <!--
            2026-09-15 — el aviso como burbuja arriba en el centro de la pantalla principal (antes quedaba
            pegado a la esquina del escritorio virtual), con la flor y los atajos dibujados como teclas.
        -->
        <Border x:Name="Hint"
                Padding="16,11,16,12"
                CornerRadius="20"
                Background="#F00C0E14"
                BorderBrush="#30FFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.4" Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <a11y:DecorativeMark Focusable="False"
                                         Width="16"
                                         Height="16"
                                         VerticalAlignment="Center"
                                         Style="{StaticResource SakuraFlowerMarkStyle}" />
                    <TextBlock x:Name="HintTitle"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="Arrastra sobre el texto que quieras traducir"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}" />
                </StackPanel>
                <ItemsControl x:Name="HintKeys" Margin="0,9,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,12,0" Orientation="Horizontal">
                                <ItemsControl ItemsSource="{Binding KeyParts}" Style="{StaticResource CompactKeycapsStyle}" />
                                <TextBlock Text="{Binding Action}"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushTextTertiary}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
